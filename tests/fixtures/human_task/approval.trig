# Human-task fixture (M009/S04, ADR-0009): an expense approval process whose
# one user task waits for a manager on a generated form.
#
#   submit page (/)         : the employee's form submits an expense, which
#                             starts :approval_process.
#   persist_expense         : service task; stores the expense and moves it
#                             from draft to submitted.
#   approve_expense         : user task; seam:completedOn :approve_form on the
#                             approvals page (/approvals), governed by
#                             :manager_approval_policy with the task as the
#                             odrl:target.
#
# One model graph per notation plus the seams graph (ADR-0001).

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix hydra:  <http://www.w3.org/ns/hydra/core#> .
@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix seam:   <https://w3id.org/seams/seam#> .
@prefix arch:   <https://w3id.org/seams/arch#> .
@prefix ifml:   <https://w3id.org/seams/ifml#> .
@prefix state:  <https://w3id.org/seams/state#> .
@prefix comm:   <https://w3id.org/seams/comm#> .
@prefix deploy: <https://w3id.org/seams/deploy#> .
@prefix proc:   <https://w3id.org/seams/proc#> .
@prefix :       <https://example.org/expenses/> .

<urn:seams:graph:model:expense_architecture> {

    :expense_architecture a seam:Model ; rdfs:label "Expense Architecture" .

    :expense_system a arch:System ; rdfs:label "Expenses" ;
        arch:contains :expense_portal , :expense_api ;
        seam:inModel :expense_architecture .

    :expense_portal a arch:Container ; rdfs:label "Expense Portal" ;
        arch:dependsOn :expense_api ;
        deploy:artifact [ a deploy:Artifact ; deploy:reference "ghcr.io/example/expense-portal" ;
                          deploy:version "0.1.0" ] ;
        deploy:port [ a deploy:Port ; deploy:containerPort 8000 ; deploy:publishedPort 8080 ] ;
        seam:inModel :expense_architecture .

    :expense_api a arch:Container ; rdfs:label "Expense API" ;
        deploy:artifact [ a deploy:Artifact ; deploy:reference "ghcr.io/example/expense-api" ;
                          deploy:version "0.1.0" ] ;
        deploy:port [ a deploy:Port ; deploy:containerPort 8000 ] ;
        seam:inModel :expense_architecture .
}

<urn:seams:graph:model:expense_ifml> {

    :expense_ifml a seam:Model , ifml:InteractionModel ; rdfs:label "Expense Interface" ;
        ifml:contains :submit_page , :approvals_page .

    # The employee's page.
    :submit_page a ifml:ViewContainer ; rdfs:label "Expenses" ;
        ifml:isLandmark true ; ifml:path "/" ;
        ifml:contains :expense_list , :expense_form ;
        seam:inModel :expense_ifml .

    :expense_list a ifml:List ; rdfs:label "Expenses" ; ifml:order 0 ;
        seam:inModel :expense_ifml .

    :expense_form a ifml:Form ; rdfs:label "New Expense" ; ifml:order 1 ;
        ifml:hasEvent :submit_expense ;
        ifml:hasParameter :expense , :description_input , :amount_input ;
        seam:inModel :expense_ifml .

    # The correlation key: its label is the {expense} variable of both POST paths.
    :expense a ifml:Parameter ; rdfs:label "expense" ;
        seam:inModel :expense_ifml .
    :description_input a ifml:Parameter ; rdfs:label "description" ;
        ifml:boundTo :description ; seam:inModel :expense_ifml .
    :amount_input a ifml:Parameter ; rdfs:label "amount" ;
        ifml:boundTo :amount ; seam:inModel :expense_ifml .

    :submit_expense a ifml:Event ; rdfs:label "Submit Expense" ;
        ifml:trigger "submit" ; seam:inModel :expense_ifml .

    :submit_to_list a ifml:NavigationFlow ;
        ifml:source :submit_expense ; ifml:target :expense_list ;
        ifml:swap ifml:Append ; seam:inModel :expense_ifml .

    # The manager's page: the screen the approval task is completed on, since
    # it ifml:contains :approve_form (ADR-0009 screen rule).
    :approvals_page a ifml:ViewContainer ; rdfs:label "Approvals" ;
        ifml:path "/approvals" ;
        ifml:contains :expense_details , :approve_form ;
        seam:inModel :expense_ifml .

    :expense_details a ifml:Details ; rdfs:label "Expense" ; ifml:order 0 ;
        ifml:hasParameter :approved_expense ;
        seam:inModel :expense_ifml .
    :approved_expense a ifml:Parameter ; rdfs:label "approved expense" ;
        seam:inModel :expense_ifml .

    :approve_form a ifml:Form ; rdfs:label "Approve Expense" ; ifml:order 1 ;
        ifml:hasEvent :submit_approval ;
        ifml:hasParameter :decision_input , :comment_input ;
        seam:inModel :expense_ifml .
    :decision_input a ifml:Parameter ; rdfs:label "decision" ;
        ifml:boundTo :decision ; seam:inModel :expense_ifml .
    :comment_input a ifml:Parameter ; rdfs:label "comment" ;
        ifml:boundTo :comment ; seam:inModel :expense_ifml .

    :submit_approval a ifml:Event ; rdfs:label "Submit Approval" ;
        ifml:trigger "submit" ; seam:inModel :expense_ifml .

    :approval_to_details a ifml:NavigationFlow ;
        ifml:source :submit_approval ; ifml:target :expense_details ;
        ifml:swap ifml:Replace ; seam:inModel :expense_ifml .
}

<urn:seams:graph:model:approval_bpmn> {

    :approval_bpmn a seam:Model ; rdfs:label "Expense Approval (BPMN)" .

    :approval_process a proc:Process ; rdfs:label "Expense Approval" ;
        seam:inModel :approval_bpmn .

    <https://example.org/expenses/approval_bpmn#persist_expense> a proc:ServiceTask ;
        rdfs:label "Persist Expense" ;
        seam:inModel :approval_bpmn .

    <https://example.org/expenses/approval_bpmn#approve_expense> a proc:UserTask ;
        rdfs:label "Approve Expense" ;
        seam:inModel :approval_bpmn .
}

<urn:seams:graph:model:expense_data> {

    :expense_data a seam:Model ; rdfs:label "Expense Data" .

    # Identifier convention: a shape addressed in a URL carries one string :id
    # (optional here: the {expense} path variable carries it on submit).
    :ExpenseShape a sh:NodeShape ; rdfs:label "Expense" ;
        sh:property [ sh:path :id ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:order 0 ] ;
        sh:property [ sh:path :description ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                      sh:maxLength 200 ; sh:order 1 ] ;
        sh:property [ sh:path :amount ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
                      sh:minExclusive 0 ; sh:order 2 ] ;
        # Values are the rdfs:labels of :expense_lifecycle's states.
        sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:order 3 ;
                      sh:in ( "draft" "submitted" ) ] ;
        seam:inModel :expense_data .

    :ApprovalShape a sh:NodeShape ; rdfs:label "Approval" ;
        sh:property [ sh:path :decision ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                      sh:in ( "approved" "rejected" ) ; sh:order 0 ] ;
        sh:property [ sh:path :comment ; sh:datatype xsd:string ; sh:maxCount 1 ;
                      sh:maxLength 500 ; sh:order 1 ] ;
        seam:inModel :expense_data .
}

<urn:seams:graph:model:expense_lifecycle> {

    :expense_lifecycle a state:StateMachine , seam:Model ; rdfs:label "Expense Lifecycle" ;
        state:initial :s_draft ;
        state:hasState :s_draft , :s_submitted ;
        state:hasTransition :t_submit .
    :s_draft a state:State ; rdfs:label "draft" ; seam:inModel :expense_lifecycle .
    :s_submitted a state:State ; rdfs:label "submitted" ; seam:inModel :expense_lifecycle .
    :t_submit a state:Transition ; state:from :s_draft ; state:to :s_submitted ;
        state:trigger "submit" ; seam:inModel :expense_lifecycle .
}

<urn:seams:graph:seams> {

    # Architecture -> UI, process, operations
    :expense_portal seam:presents :expense_ifml ;
        seam:consumes :submit_expense_op , :list_expenses_op , :approve_expense_op , :expense_details_op .
    :expense_api seam:exposes :submit_expense_op , :list_expenses_op , :approve_expense_op , :expense_details_op ;
        seam:executes :approval_process .

    # UI -> process and operations
    :submit_expense seam:triggers :approval_process ;
        seam:submitsTo :submit_expense_op ;
        seam:governedBy :employee_submit_policy .
    # The completion event: no seam:triggers, the process is already waiting.
    :submit_approval seam:submitsTo :approve_expense_op .

    :submit_expense_op seam:rendersComponent :expense_list ;
        seam:governedBy :employee_submit_policy .
    :list_expenses_op seam:rendersComponent :expense_list .
    :approve_expense_op seam:rendersComponent :expense_details .
    :expense_details_op seam:rendersComponent :expense_details .

    :expense_list seam:reads :ExpenseShape .
    :expense_details seam:reads :ExpenseShape .
    :expense_form seam:writes :ExpenseShape .
    :approve_form seam:writes :ApprovalShape .

    # Process -> data, UI and policy
    :approval_process seam:detailedBy :approval_bpmn ;
        proc:correlationKey :expense .

    <https://example.org/expenses/approval_bpmn#persist_expense>
        seam:invokes :submit_expense_op ;
        seam:writes :ExpenseShape ;
        seam:fires :t_submit .

    # The human task (ADR-0009): it waits for a person on :approve_form, and
    # only an assignee of :manager_approval_policy may complete it.
    <https://example.org/expenses/approval_bpmn#approve_expense>
        seam:reads :ExpenseShape ;
        seam:completedOn :approve_form ;
        seam:writes :ApprovalShape ;
        seam:governedBy :manager_approval_policy .

    :ExpenseShape seam:lifecycle :expense_lifecycle ;
        seam:detailedBy :expense_data .

    # Navigation predicates
    :expense_architecture seam:notation seam:C4 .
    :expense_ifml seam:notation seam:IFML .
    :approval_bpmn seam:notation seam:BPMN ;
        seam:renderPayload <approval.bpmn> .
    :expense_data seam:notation seam:ShapeGraph .
    :expense_lifecycle seam:notation seam:Statechart .

    # Communication contracts
    :submit_expense_op a hydra:Operation ; rdfs:label "Submit Expense" ;
        hydra:method "POST" ;
        seam:acceptsShape :ExpenseShape ;
        seam:returnsShape :ExpenseShape ;
        seam:mediaKind seam:UIFragment ;
        comm:requestMediaType "application/x-www-form-urlencoded" ;
        comm:path [ a hydra:IriTemplate ;
                    hydra:template "/expenses/{expense}" ;
                    hydra:mapping [ a hydra:IriTemplateMapping ;
                                    hydra:variable "expense" ;
                                    hydra:property :id ] ] .

    :list_expenses_op a hydra:Operation ; rdfs:label "List Expenses" ;
        hydra:method "GET" ;
        seam:returnsShape :ExpenseShape ;
        seam:mediaKind seam:UIFragment ;
        comm:path [ a hydra:IriTemplate ; hydra:template "/expenses" ] .

    :approve_expense_op a hydra:Operation ; rdfs:label "Approve Expense" ;
        hydra:method "POST" ;
        seam:acceptsShape :ApprovalShape ;
        seam:returnsShape :ExpenseShape ;
        seam:mediaKind seam:UIFragment ;
        comm:requestMediaType "application/x-www-form-urlencoded" ;
        comm:path [ a hydra:IriTemplate ;
                    hydra:template "/expenses/{expense}/approval" ;
                    hydra:mapping [ a hydra:IriTemplateMapping ;
                                    hydra:variable "expense" ;
                                    hydra:property :id ] ] .

    :expense_details_op a hydra:Operation ; rdfs:label "Expense Details" ;
        hydra:method "GET" ;
        seam:returnsShape :ExpenseShape ;
        seam:mediaKind seam:UIFragment ;
        comm:path [ a hydra:IriTemplate ;
                    hydra:template "/expenses/{expense}" ;
                    hydra:mapping [ a hydra:IriTemplateMapping ;
                                    hydra:variable "expense" ;
                                    hydra:property :id ] ] .

    # Authorization. The approval policy targets the user task itself (ADR-0009):
    # the runtime evaluates it when someone lists or completes the task.
    :employee_submit_policy a odrl:Policy ; rdfs:label "Employees may submit expenses" ;
        odrl:permission [ a odrl:Permission ;
                          odrl:target :submit_expense_op ;
                          odrl:action odrl:use ;
                          odrl:assignee :employee ] .
    :manager_approval_policy a odrl:Policy ; rdfs:label "Managers may approve expenses" ;
        odrl:permission [ a odrl:Permission ;
                          odrl:target <https://example.org/expenses/approval_bpmn#approve_expense> ;
                          odrl:action odrl:use ;
                          odrl:assignee :manager ] .
    :employee a odrl:PartyCollection ; rdfs:label "Employees" .
    :manager a odrl:PartyCollection ; rdfs:label "Managers" .
}
