<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="payout_bpmn_defs"
                   targetNamespace="https://example.org/expenses/payout_bpmn">
  <bpmn:process id="payout_process" name="Expense Payout" isExecutable="true">
    <!-- A message start event: the graph says it seam:subscribesTo :payouts (ADR-0010). -->
    <bpmn:startEvent id="payout_requested" name="Payout Requested">
      <bpmn:outgoing>flow_to_schedule</bpmn:outgoing>
      <bpmn:messageEventDefinition id="payout_requested_msg" />
    </bpmn:startEvent>

    <bpmn:serviceTask id="schedule_payout" name="Schedule Payout">
      <bpmn:incoming>flow_to_schedule</bpmn:incoming>
      <bpmn:outgoing>flow_to_choose</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="choose_payout" name="Choose Payout">
      <bpmn:incoming>flow_to_choose</bpmn:incoming>
      <bpmn:outgoing>flow_to_gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="method_gateway" name="Method?">
      <bpmn:incoming>flow_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_batch</bpmn:outgoing>
      <bpmn:outgoing>flow_now</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="add_to_batch" name="Add to Batch">
      <bpmn:incoming>flow_batch</bpmn:incoming>
      <bpmn:outgoing>flow_batched_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="send_now" name="Send Now">
      <bpmn:incoming>flow_now</bpmn:incoming>
      <bpmn:outgoing>flow_sent_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="paid_out" name="Paid Out">
      <bpmn:incoming>flow_batched_end</bpmn:incoming>
      <bpmn:incoming>flow_sent_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_to_schedule" sourceRef="payout_requested" targetRef="schedule_payout" />
    <bpmn:sequenceFlow id="flow_to_choose" sourceRef="schedule_payout" targetRef="choose_payout" />
    <bpmn:sequenceFlow id="flow_to_gateway" sourceRef="choose_payout" targetRef="method_gateway" />
    <bpmn:sequenceFlow id="flow_batch" name="batch" sourceRef="method_gateway" targetRef="add_to_batch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method == "batch"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_now" name="now" sourceRef="method_gateway" targetRef="send_now">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method == "now"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_batched_end" sourceRef="add_to_batch" targetRef="paid_out" />
    <bpmn:sequenceFlow id="flow_sent_end" sourceRef="send_now" targetRef="paid_out" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="payout_process">
      <bpmndi:BPMNShape id="payout_requested_di" bpmnElement="payout_requested">
        <dc:Bounds x="60" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="schedule_payout_di" bpmnElement="schedule_payout">
        <dc:Bounds x="150" y="98" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="choose_payout_di" bpmnElement="choose_payout">
        <dc:Bounds x="300" y="98" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="method_gateway_di" bpmnElement="method_gateway" isMarkerVisible="true">
        <dc:Bounds x="450" y="113" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="add_to_batch_di" bpmnElement="add_to_batch">
        <dc:Bounds x="560" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_now_di" bpmnElement="send_now">
        <dc:Bounds x="560" y="176" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="paid_out_di" bpmnElement="paid_out">
        <dc:Bounds x="722" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_schedule_di" bpmnElement="flow_to_schedule">
        <di:waypoint x="96" y="138" />
        <di:waypoint x="150" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_choose_di" bpmnElement="flow_to_choose">
        <di:waypoint x="250" y="138" />
        <di:waypoint x="300" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_gateway_di" bpmnElement="flow_to_gateway">
        <di:waypoint x="400" y="138" />
        <di:waypoint x="450" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_batch_di" bpmnElement="flow_batch">
        <di:waypoint x="475" y="113" />
        <di:waypoint x="475" y="60" />
        <di:waypoint x="560" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_now_di" bpmnElement="flow_now">
        <di:waypoint x="475" y="163" />
        <di:waypoint x="475" y="216" />
        <di:waypoint x="560" y="216" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_batched_end_di" bpmnElement="flow_batched_end">
        <di:waypoint x="660" y="60" />
        <di:waypoint x="740" y="60" />
        <di:waypoint x="740" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sent_end_di" bpmnElement="flow_sent_end">
        <di:waypoint x="660" y="216" />
        <di:waypoint x="740" y="216" />
        <di:waypoint x="740" y="156" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
