[# The docker compose file of the arch:System's containers in one arch:Environment
   (seams_gen.compose, D018, ADR-0015). Every value is pre-rendered as a YAML
   scalar by the extractor. #]
# Generated by the seams compose generator from the [[ c.model_stem ]] model. Do not edit.
# model-hash: [[ c.model_hash ]]
# environment: [[ c.environment ]]
name: [[ c.project ]]
services:
[% for s in c.services %]
  [[ s.name ]]:
    image: [[ s.image ]]
[% if s.build %]
    build:
      context: [[ s.build.context ]]
[% if s.build.dockerfile %]
      dockerfile: [[ s.build.dockerfile ]]
[% endif %]
[% if s.build.args %]
      args:
[% for key, value in s.build.args %]
        [[ key ]]: [[ value ]]
[% endfor %]
[% endif %]
    pull_policy: build
[% endif %]
[% if s.command %]
    command: [[ s.command ]]
[% endif %]
[% if s.ports %]
    ports:
[% for p in s.ports %]
      - "[[ p ]]"
[% endfor %]
[% endif %]
[% if s.expose %]
    expose:
[% for p in s.expose %]
      - "[[ p ]]"
[% endfor %]
[% endif %]
[% if s.depends_on %]
    depends_on:
[% for d in s.depends_on %]
      [[ d.name ]]:
        condition: [[ d.condition ]]
[% endfor %]
[% endif %]
[% if s.environment %]
    environment:
[% for key, value in s.environment %]
      [[ key ]]: [[ value ]]
[% endfor %]
[% endif %]
[% if s.secrets %]
    secrets:
[% for k in s.secrets %]
      - [[ k ]]
[% endfor %]
[% endif %]
[% if s.volumes %]
    volumes:
[% for v in s.volumes %]
      - [[ v ]]
[% endfor %]
[% endif %]
[% if s.healthcheck %]
    healthcheck:
      test: ["CMD-SHELL", [[ s.healthcheck.test ]]]
      interval: [[ s.healthcheck.interval ]]
      timeout: 5s
      retries: 12
      start_period: 5s
[% endif %]
[% if s.replicas is not none or s.placement %]
    deploy:
[% if s.declared_replicas is not none %]
      # The model declares [[ s.declared_replicas ]] replicas; one until backlog A10 moves process state out of the process.
[% endif %]
[% if s.replicas is not none %]
      replicas: [[ s.replicas ]]
[% endif %]
[% if s.placement %]
      placement:
        constraints:
          - [[ s.placement ]]
[% endif %]
[% endif %]
[% endfor %]
[% if c.secrets %]
secrets:
[% for s in c.secrets %]
  [[ s.key ]]:
[% if s.file %]
    file: [[ s.file ]]
[% else %]
    name: [[ s.name ]]
    external: true
[% endif %]
[% endfor %]
[% endif %]
[% if c.volumes %]
volumes:
[% for v in c.volumes %]
  [[ v ]]: {}
[% endfor %]
[% endif %]
