[#- One item of an ifml:Details item list (D016), included inside the
    Details {% for %} loop and by htmx_fragment.html.j2 as an item partial
    (GAP-19). Expects `c`, a Details Component. #]
      <li class="[[ c.item_class ]]">
[% for fl in c.fields %]
[% if fl.is_textarea %]
        <p>{{ [[ c.loop_var ]].[[ fl.name ]] }}</p>
[% elif fl.is_datetime %]
        <time datetime="{{ [[ c.loop_var ]].[[ fl.name ]] }}">{{ [[ c.loop_var ]].[[ fl.name ]] }}</time>
[% else %]
        <span class="[[ fl.name ]]">{{ [[ c.loop_var ]].[[ fl.name ]] }}</span>
[% endif %]
[% endfor %]
      </li>
