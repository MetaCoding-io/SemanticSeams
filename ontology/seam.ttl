@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix hydra: <http://www.w3.org/ns/hydra/core#> .
@prefix seam:  <https://w3id.org/seams/seam#> .

<https://w3id.org/seams/seam> a owl:Ontology ;
    rdfs:label "SemanticSeams Bridging Ontology" ;
    rdfs:comment """The cross-layer predicates that weld architecture, UI, process,
decision, state, data, communication, authorization, and planning models into one
navigable graph. Design rules: (1) few and generic beats many and precise;
(2) every predicate must earn a cross-layer query; (3) reuse existing vocabularies
inside layers, mint here only where layers meet; (4) the navigation backbone stays
notation-agnostic.""" .

#################################################################
# Navigation backbone
#################################################################

seam:Model a rdfs:Class ;
    rdfs:label "Model" ;
    rdfs:comment "A diagram/model in some notation; typically stored as its own named graph." .

seam:detailedBy a rdf:Property ;
    seam:reveal seam:Open ;
    rdfs:label "detailed by" ;
    rdfs:range seam:Model ;
    rdfs:comment "Focus element -> model that elaborates it. Traversing this edge is 'zooming in'." .

seam:notation a rdf:Property ;
    rdfs:label "notation" ;
    rdfs:domain seam:Model ;
    rdfs:range seam:Notation ;
    rdfs:comment "Which renderer the shell mounts for this model." .

seam:inModel a rdf:Property ;
    rdfs:label "in model" ;
    rdfs:range seam:Model ;
    rdfs:comment """Element -> the seam:Model it belongs to. Membership as DATA: the
fragment-IRI convention (:order_bpmn#persist_task) is a rendering-dispatch naming
scheme that SPARQL cannot traverse; this edge is what cross-layer property paths
walk (e.g. process -> seam:detailedBy -> model -> ^seam:inModel -> task). Asserted
for every lifted element. For elements whose triples are native RDF (IFML, states,
shapes), it is asserted alongside layer containment until named-graph partitioning
(ADR-0001) lands. Earns every query that crosses a model boundary.""" .

seam:C4         a seam:Notation ; rdfs:label "C4-style architecture view" .
seam:IFML       a seam:Notation ; rdfs:label "IFML interaction model" .
seam:BPMN       a seam:Notation ; rdfs:label "BPMN 2.0 process diagram" .
seam:DMN        a seam:Notation ; rdfs:label "DMN decision model" .
seam:Statechart a seam:Notation ; rdfs:label "Harel statechart" .
seam:ShapeGraph a seam:Notation ; rdfs:label "RDF/SHACL data-model view" .

seam:Notation a rdfs:Class ;
    rdfs:label "Notation" .

seam:renderPayload a rdf:Property ;
    rdfs:label "render payload" ;
    rdfs:domain seam:Model ;
    rdfs:comment """Link to (or literal containing) the native serialization used for
rendering, e.g. BPMN 2.0 XML or DMN XML. Native payloads are kept as-is; only
seam-participating elements are lifted to IRIs. Convention: native element IDs
become IRI fragments on the model IRI, e.g. :order_bpmn#persist_task.""" .

#################################################################
# Reveal modes
#################################################################

seam:RevealMode a rdfs:Class ;
    rdfs:label "Reveal mode" ;
    rdfs:comment """How the viewer reveals a seam edge's target when the source is
clicked (docs/research/2026-10-15-reveal-modes.md section 2, ADR-0005 as amended).
Replaces the boolean navigational set: open and nest predicates navigate, layer
predicates stay inspector-only until layer mode lands.""" .

seam:reveal a owl:AnnotationProperty ;
    rdfs:label "reveal" ;
    rdfs:range seam:RevealMode ;
    rdfs:comment """seam predicate -> its default seam:RevealMode. Every seam predicate
except the administrative ones (inModel, notation, renderPayload) declares exactly
one (constraint in shapes/seam-shapes.ttl). An annotation, not a seam edge: it
describes predicates, never model elements.""" .

seam:Open  a seam:RevealMode ; rdfs:label "open" ;
    rdfs:comment "The view is replaced by the target's model in its own notation; a breadcrumb records the hop and the predicate." .
seam:Nest  a seam:RevealMode ; rdfs:label "nest" ;
    rdfs:comment "The target's model is drawn inside the source's card, scaled down; neighbours are pushed aside; a second click collapses it." .
seam:Layer a seam:RevealMode ; rdfs:label "layer" ;
    rdfs:comment "Every layer sits on its own plane, stacked; the seam is drawn as a line between planes; hovering an element traces all of its seams." .

#################################################################
# Architecture <-> everything
#################################################################

seam:presents a rdf:Property ;
    seam:reveal seam:Nest ;
    rdfs:label "presents" ;
    rdfs:comment "arch:Container -> IFML seam:Model. The container's user-facing surface. (Resolved Container per review triage; a Component variant can wait.)" .

seam:exposes a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "exposes" ;
    rdfs:comment "arch:Container -> comm:Operation | comm:Channel." .

seam:consumes a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "consumes" ;
    rdfs:comment "arch:Container -> comm:Operation | comm:Channel. The dependency edge." .

seam:deployedTo a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "deployed to" ;
    rdfs:comment "arch:Container -> arch:DeploymentNode. Enables 'what breaks if db02 goes away'." .

seam:executes a rdf:Property ;
    seam:reveal seam:Nest ;
    rdfs:label "executes" ;
    rdfs:comment "arch:Container -> proc:Process it runs. Completes impact analysis: 'what breaks if node X dies' must reach the process layer, and the generic graph-literate worker needs to know where a task's process lives." .

#################################################################
# Data <-> architecture
#################################################################

seam:storedIn a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "stored in" ;
    rdfs:comment "sh:NodeShape -> arch:Container (a store) that persists its instances. Lets impact-of-node.rq answer which data is lost if a node goes away (ADR-0011). (Constraint in shapes/seam-shapes.ttl.)" .

#################################################################
# UI <-> process
#################################################################

seam:triggers a rdf:Property ;
    seam:reveal seam:Open ;
    rdfs:label "triggers" ;
    rdfs:comment "ifml:Event -> proc:Process | dec:Decision. IFML's action-reference extension point, made concrete." .

seam:completedOn a rdf:Property ;
    seam:reveal seam:Open ;
    rdfs:label "completed on" ;
    rdfs:comment """proc:UserTask -> ifml:Form on which a person completes the task, at
most one per task (ADR-0009, decision D027). The mirror of seam:triggers: an event
starts a process, a user task waits for a form. The screen is the
ifml:ViewContainer that ifml:contains the form; the form's one event
seam:submitsTo the completion operation, and the form seam:writes the task's
output shape. Authorization: the task's seam:governedBy policies are evaluated
with the task IRI as the odrl:target; an ungoverned task is open to any
authenticated identity. Earns the query 'which screens must a person visit to
finish this process' (docs/queries/screens-to-finish-process.rq). (Constraint in
shapes/seam-shapes.ttl.)""" .

seam:visibleWhen a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "visible when" ;
    rdfs:comment """ifml:ViewComponent -> state:State. Conditional rendering as a graph edge.
Multi-valued: the component is visible when the state is any one of its values.
Evaluation rule: the guard is evaluated server-side, at render time, against the
lifecycle of the shape the component seam:reads (shape seam:lifecycle machine, which
must state:hasState every guard state). The template variable is the shape's local name,
lowercased, minus a trailing 'shape', plus '_state' (:MessageShape -> message_state),
compared with the guard state's rdfs:label (one state: ==, several: in a tuple of the
labels, sorted). The value is the state of the current
instance in the component's render context (for the message thread, the conversation's
latest message). A state change re-renders the component through the channel events
the client consumes (comm:eventName on a seam:consumes channel); no client-side guard.""" .

#################################################################
# UI <-> communication
#################################################################

seam:submitsTo a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "submits to" ;
    rdfs:comment """ifml:Event -> hydra:Operation the event calls (the form's hx-post,
the FastAPI route). seam:triggers names the process the event starts; the
operation's handler starts it. Earns the query 'which route does this UI event
call, and which policies must that route enforce' (event -> seam:submitsTo ->
operation -> seam:governedBy). (Constraint in shapes/seam-shapes.ttl.)""" .

seam:rendersComponent a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "renders component" ;
    rdfs:comment """hydra:Operation -> ifml:ViewComponent whose partial is the
operation's seam:UIFragment response. The template name derives from the
component (ADR-0007 component -> partial): <component>.html when the flow that
lands the response swaps ifml:Replace, <component>_item.html when it swaps
ifml:Append or ifml:Prepend. The inverse earns 'which endpoint loads or updates
this component' (the hx-get of a list or details). (Constraint in
shapes/seam-shapes.ttl.)""" .

#################################################################
# Process <-> decisions, communication, data
#################################################################

seam:decidedBy a rdf:Property ;
    seam:reveal seam:Open ;
    rdfs:label "decided by" ;
    rdfs:comment "proc business-rule task -> dec:Decision." .

seam:invokes a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "invokes" ;
    rdfs:comment "proc service task -> comm:Operation." .

seam:publishesTo a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "publishes to" ;
    rdfs:comment "proc message throw event (completion event, named by the channel's rdfs:label) | proc service task that seam:invokes an operation (each streamed delta of that operation's reply, named by comm:eventName) -> comm:Channel." .

seam:subscribesTo a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "subscribes to" ;
    rdfs:comment "proc message catch event -> comm:Channel. On a process's start event it makes the process channel-started: each publish on the channel starts an instance (ADR-0010)." .

seam:reads a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "reads" ;
    rdfs:comment "task | view component | decision -> sh:NodeShape it reads. Workhorse of impact analysis. (Constraint lives in shapes/seam-shapes.ttl, not rdfs:range: RDFS ranges infer, they don't reject.)" .

seam:writes a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "writes" ;
    rdfs:comment "task | ui event -> sh:NodeShape it writes. Workhorse of impact analysis. (Constraint in shapes/seam-shapes.ttl.)" .

#################################################################
# Data <-> lifecycle
#################################################################

seam:lifecycle a rdf:Property ;
    seam:reveal seam:Open ;
    rdfs:label "lifecycle" ;
    rdfs:comment "sh:NodeShape -> state:StateMachine governing instances of the shape. (Constraint in shapes/seam-shapes.ttl.)" .

seam:fires a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "fires" ;
    rdfs:comment "proc task -> state:Transition. Inverse view: which tasks may move an Order out of 'submitted'?" .

#################################################################
# Communication contracts
#################################################################

seam:acceptsShape a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "accepts shape" ;
    rdfs:comment "operation | channel -> request / event payload sh:NodeShape. (Constraint in shapes/seam-shapes.ttl.)" .

seam:returnsShape a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "returns shape" ;
    rdfs:comment """operation -> response payload sh:NodeShape. For operations whose
seam:mediaKind is seam:UIFragment, this describes the shape of the DATA the fragment
renders, not the HTTP body (which is HTML). (Constraint in shapes/seam-shapes.ttl.)""" .

seam:implementedBy a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "implemented by" ;
    rdfs:domain hydra:Operation ;
    rdfs:comment """operation -> the implementation that serves it (ADR-0012). The
node's rdf:type is its kind: comm:LLMCompletion, comm:PythonHandler or
comm:HTTPEndpoint. At most one per operation; every task that invokes the
operation gets the same implementation. An operation invoked across containers
must declare one; an in-process operation with none is served by the runtime
itself. Layer reveal: the implementation is code, not a model the viewer opens.
(Constraints in shapes/seam-shapes.ttl.)""" .

seam:mediaKind a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "media kind" ;
    rdfs:range seam:MediaKind ;
    rdfs:comment "operation -> seam:UIFragment | seam:Data. The htmx two-kinds-of-API distinction." .

seam:MediaKind a rdfs:Class ;
    rdfs:label "Media kind" .
seam:UIFragment a seam:MediaKind ; rdfs:label "hypermedia / UI fragment response" .
seam:Data       a seam:MediaKind ; rdfs:label "pure data (JSON-LD) response" .

#################################################################
# Authorization (cross-cutting by design)
#################################################################

seam:governedBy a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "governed by" ;
    rdfs:comment """ANY element -> policy (odrl:Policy, or an ACP/WebACL resource —
hence no rdfs:range, which would wrongly INFER odrl:Policy on a WebACL resource).
Deliberately broad domain: attaches to events, tasks, operations, shapes,
transitions alike. Propagation rule (documented, not enforced in v1): an action is
allowed iff every edge on the UI-event -> ... -> shape path carries either no policy
or a satisfied one.""" .

#################################################################
# Profiles and planning (reserved seams)
#################################################################

seam:Profile a rdfs:Class ;
    rdfs:comment "A methodology profile: a component taxonomy plus a SHACL shapes library validating the model graph itself (e.g. IDesign)." .

seam:conformsTo a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "conforms to" ;
    rdfs:range seam:Profile .

seam:realizes a rdf:Property ;
    seam:reveal seam:Layer ;
    rdfs:label "realizes" ;
    rdfs:comment "plan:Activity -> ANY element. The single edge the Gantt projection needs." .
