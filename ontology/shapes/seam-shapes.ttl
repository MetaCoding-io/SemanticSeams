@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix hydra:  <http://www.w3.org/ns/hydra/core#> .
@prefix seam:   <https://w3id.org/seams/seam#> .
@prefix arch:   <https://w3id.org/seams/arch#> .
@prefix ifml:   <https://w3id.org/seams/ifml#> .
@prefix proc:   <https://w3id.org/seams/proc#> .
@prefix dec:    <https://w3id.org/seams/dec#> .
@prefix state:  <https://w3id.org/seams/state#> .
@prefix comm:   <https://w3id.org/seams/comm#> .
@prefix deploy: <https://w3id.org/seams/deploy#> .
@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix verify: <https://w3id.org/seams/verify#> .
@prefix seamsh: <https://w3id.org/seams/shapes#> .

<https://w3id.org/seams/shapes> a owl:Ontology ;
    rdfs:label "Seam Validation Shapes" ;
    rdfs:comment """The project's own methodology applied to itself: constraints on
the seam predicates live HERE, as SHACL shapes over the model graph — not as
rdfs:domain/range in seam.ttl, because RDFS ranges infer types onto violators
instead of rejecting them. Every shape below encodes a claim the prose ontology
comments were already making; validating a model against this file is what turns
'we follow the seam design rules' into a machine-verifiable statement.

Validate with the ontology files merged into the data graph: sh:class checks
subclass closure (e.g. proc:ServiceTask -> proc:Task) from triples in the data.""" ;
    sh:declare [ sh:prefix "seam" ; sh:namespace "https://w3id.org/seams/seam#"^^xsd:anyURI ] ,
               [ sh:prefix "ifml" ; sh:namespace "https://w3id.org/seams/ifml#"^^xsd:anyURI ] ,
               [ sh:prefix "hydra" ; sh:namespace "http://www.w3.org/ns/hydra/core#"^^xsd:anyURI ] ,
               [ sh:prefix "comm" ; sh:namespace "https://w3id.org/seams/comm#"^^xsd:anyURI ] ,
               [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "sh" ; sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ] ,
               [ sh:prefix "state" ; sh:namespace "https://w3id.org/seams/state#"^^xsd:anyURI ] ,
               [ sh:prefix "dec" ; sh:namespace "https://w3id.org/seams/dec#"^^xsd:anyURI ] ,
               [ sh:prefix "verify" ; sh:namespace "https://w3id.org/seams/verify#"^^xsd:anyURI ] ,
               [ sh:prefix "deploy" ; sh:namespace "https://w3id.org/seams/deploy#"^^xsd:anyURI ] .

#################################################################
# Navigation backbone
#################################################################

seamsh:ModelShape a sh:NodeShape ;
    sh:targetClass seam:Model ;
    sh:property [
        sh:path seam:notation ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class seam:Notation ;
        sh:message "Every seam:Model has exactly one seam:notation, and it is a seam:Notation." ;
    ] ;
    sh:sparql [
        sh:message "BPMN and DMN models must carry a seam:renderPayload (the native XML is the render source)." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this WHERE {
                $this seam:notation ?n .
                FILTER(?n IN (seam:BPMN, seam:DMN))
                FILTER NOT EXISTS { $this seam:renderPayload ?p }
            }""" ;
    ] .

seamsh:DetailedByShape a sh:NodeShape ;
    sh:targetObjectsOf seam:detailedBy ;
    sh:class seam:Model ;
    sh:message "seam:detailedBy points at a seam:Model." .

seamsh:InModelShape a sh:NodeShape ;
    sh:targetObjectsOf seam:inModel ;
    sh:class seam:Model ;
    sh:message "seam:inModel points at a seam:Model." .

#################################################################
# Reveal modes
#################################################################

seamsh:RevealShape a sh:NodeShape ;
    rdfs:comment """Every non-administrative seam predicate declares exactly one reveal
mode (ADR-0005 as amended): the viewer derives click navigation from it. Validate
with ontology/seam.ttl merged into the data graph, as the annotations live there.
A seam predicate added to seam.ttl is added here too.""" ;
    sh:targetNode
        seam:detailedBy ,
        seam:presents ,
        seam:exposes ,
        seam:consumes ,
        seam:deployedTo ,
        seam:executes ,
        seam:storedIn ,
        seam:triggers ,
        seam:completedOn ,
        seam:visibleWhen ,
        seam:submitsTo ,
        seam:rendersComponent ,
        seam:decidedBy ,
        seam:invokes ,
        seam:publishesTo ,
        seam:subscribesTo ,
        seam:reads ,
        seam:writes ,
        seam:lifecycle ,
        seam:fires ,
        seam:acceptsShape ,
        seam:returnsShape ,
        seam:mediaKind ,
        seam:implementedBy ,
        seam:catches ,
        seam:governedBy ,
        seam:conformsTo ,
        seam:realizes ;
    sh:property [
        sh:path seam:reveal ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( seam:Open seam:Nest seam:Layer ) ;
        sh:message "Every seam predicate declares exactly one seam:reveal, one of seam:Open, seam:Nest or seam:Layer." ;
    ] .

#################################################################
# Architecture <-> everything
#################################################################

seamsh:PresentsShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:presents ;
    sh:class arch:Container ;
    sh:property [ sh:path seam:presents ; sh:class seam:Model ;
        sh:message "seam:presents points at a seam:Model (an IFML surface)." ] ;
    sh:message "Only an arch:Container seam:presents a UI surface." .

seamsh:ExposesShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:exposes ;
    sh:class arch:Container ;
    sh:property [ sh:path seam:exposes ;
        sh:or ( [ sh:class hydra:Operation ] [ sh:class comm:Channel ] ) ;
        sh:message "seam:exposes points at an operation or a channel." ] .

seamsh:ConsumesShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:consumes ;
    sh:class arch:Container ;
    sh:property [ sh:path seam:consumes ;
        sh:or ( [ sh:class hydra:Operation ] [ sh:class comm:Channel ] ) ;
        sh:message "seam:consumes points at an operation or a channel." ] .

seamsh:DeployedToShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:deployedTo ;
    sh:class arch:Container ;
    sh:property [ sh:path seam:deployedTo ; sh:class arch:DeploymentNode ;
        sh:message "seam:deployedTo points at an arch:DeploymentNode." ] .

seamsh:ExecutesShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:executes ;
    sh:class arch:Container ;
    sh:property [ sh:path seam:executes ; sh:class proc:Process ;
        sh:message "seam:executes points at a proc:Process." ] .

#################################################################
# UI <-> process
#################################################################

seamsh:TriggersShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:triggers ;
    sh:class ifml:Event ;
    sh:property [ sh:path seam:triggers ;
        sh:or ( [ sh:class proc:Process ] [ sh:class dec:Decision ] ) ;
        sh:message "seam:triggers points at a process or a decision." ] ;
    sh:message "Only an ifml:Event seam:triggers behavior." .

seamsh:CompletedOnShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:completedOn ;
    sh:class proc:UserTask ;
    sh:property [ sh:path seam:completedOn ; sh:class ifml:Form ; sh:maxCount 1 ;
        sh:message "seam:completedOn points at one ifml:Form." ] ;
    sh:message "Only a proc:UserTask seam:completedOn a form." .

seamsh:VisibleWhenShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:visibleWhen ;
    sh:class ifml:ViewComponent ;
    sh:property [ sh:path seam:visibleWhen ; sh:class state:State ;
        sh:message "seam:visibleWhen points at a state:State." ] .

#################################################################
# UI <-> communication
#################################################################

seamsh:SubmitsToShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:submitsTo ;
    sh:class ifml:Event ;
    sh:property [ sh:path seam:submitsTo ; sh:class hydra:Operation ;
        sh:message "seam:submitsTo points at a hydra:Operation." ] ;
    sh:message "Only an ifml:Event seam:submitsTo an operation." .

seamsh:RendersComponentShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:rendersComponent ;
    sh:class hydra:Operation ;
    sh:property [ sh:path seam:rendersComponent ; sh:class ifml:ViewComponent ;
        sh:message "seam:rendersComponent points at an ifml:ViewComponent." ] ;
    sh:message "Only a hydra:Operation seam:rendersComponent." .

seamsh:SwapShape a sh:NodeShape ;
    sh:targetSubjectsOf ifml:swap ;
    sh:class ifml:NavigationFlow ;
    sh:property [ sh:path ifml:swap ; sh:maxCount 1 ;
        sh:in ( ifml:Replace ifml:Append ifml:Prepend ) ;
        sh:message "ifml:swap is at most one of ifml:Replace, ifml:Append or ifml:Prepend." ] ;
    sh:message "Only an ifml:NavigationFlow carries ifml:swap." .

seamsh:BoundToShape a sh:NodeShape ;
    sh:targetSubjectsOf ifml:boundTo ;
    sh:class ifml:Parameter ;
    sh:property [ sh:path ifml:boundTo ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "ifml:boundTo names at most one property IRI." ] ;
    sh:message "Only an ifml:Parameter is ifml:boundTo a property." .

seamsh:OrderShape a sh:NodeShape ;
    sh:targetSubjectsOf ifml:order ;
    sh:class ifml:ViewComponent ;
    sh:property [ sh:path ifml:order ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:message "ifml:order is at most one xsd:integer per component." ] ;
    sh:message "Only an ifml:ViewComponent carries ifml:order." .

# Separate shape so the node-level message above does not attach to its results.
seamsh:OrderUniqueShape a sh:NodeShape ;
    sh:targetSubjectsOf ifml:order ;
    sh:sparql [
        sh:message "ifml:order is unique among the components of one ViewContainer." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this WHERE {
                ?container ifml:contains $this , ?other .
                FILTER(?other != $this)
                $this ifml:order ?n . ?other ifml:order ?m .
                FILTER(?n = ?m)
            }""" ;
    ] .

#################################################################
# Process <-> decisions, communication, data
#################################################################

seamsh:DecidedByShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:decidedBy ;
    sh:class proc:BusinessRuleTask ;
    sh:property [ sh:path seam:decidedBy ; sh:class dec:Decision ;
        sh:message "seam:decidedBy points at a dec:Decision." ] ;
    sh:message "seam:decidedBy connects only business-rule tasks to decisions." .

seamsh:InvokesShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:invokes ;
    sh:class proc:ServiceTask ;
    sh:property [ sh:path seam:invokes ; sh:class hydra:Operation ;
        sh:message "seam:invokes points at a hydra:Operation." ] ;
    sh:message "Only a proc:ServiceTask seam:invokes an operation." .

seamsh:PublishesToShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:publishesTo ;
    sh:or ( [ sh:class proc:MessageThrowEvent ] [ sh:class proc:ServiceTask ] ) ;
    sh:property [ sh:path seam:publishesTo ; sh:class comm:Channel ;
        sh:message "seam:publishesTo points at a comm:Channel." ] ;
    sh:message "Only a proc:MessageThrowEvent or a proc:ServiceTask seam:publishesTo a channel (D046)." .

seamsh:SubscribesToShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:subscribesTo ;
    sh:class proc:MessageCatchEvent ;
    sh:property [ sh:path seam:subscribesTo ; sh:class comm:Channel ;
        sh:message "seam:subscribesTo points at a comm:Channel." ] .

seamsh:ReadsShape a sh:NodeShape ;
    sh:targetObjectsOf seam:reads ;
    sh:class sh:NodeShape ;
    sh:message "seam:reads points at a sh:NodeShape." .

seamsh:WritesShape a sh:NodeShape ;
    sh:targetObjectsOf seam:writes ;
    sh:class sh:NodeShape ;
    sh:message "seam:writes points at a sh:NodeShape." .

#################################################################
# Data <-> lifecycle
#################################################################

seamsh:LifecycleShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:lifecycle ;
    sh:class sh:NodeShape ;
    sh:property [ sh:path seam:lifecycle ; sh:class state:StateMachine ;
        sh:message "seam:lifecycle points at a state:StateMachine." ] ;
    sh:message "Only a sh:NodeShape carries a seam:lifecycle." .

seamsh:FiresShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:fires ;
    sh:class proc:Task ;
    sh:property [ sh:path seam:fires ; sh:class state:Transition ;
        sh:message "seam:fires points at a state:Transition." ] ;
    sh:message "Only a proc:Task seam:fires a transition." .

#################################################################
# Communication contracts
#################################################################

seamsh:AcceptsShapeShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:acceptsShape ;
    sh:or ( [ sh:class hydra:Operation ] [ sh:class comm:Channel ] ) ;
    sh:property [ sh:path seam:acceptsShape ; sh:class sh:NodeShape ;
        sh:message "seam:acceptsShape points at a sh:NodeShape." ] ;
    sh:message "Only operations and channels declare seam:acceptsShape." .

seamsh:ReturnsShapeShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:returnsShape ;
    sh:or ( [ sh:class hydra:Operation ] [ sh:class hydra:Status ] ) ;
    sh:property [ sh:path seam:returnsShape ; sh:class sh:NodeShape ;
        sh:message "seam:returnsShape points at a sh:NodeShape." ] ;
    sh:message "Only operations and their hydra:Status responses (ADR-0013) declare seam:returnsShape." .

seamsh:MediaKindShape a sh:NodeShape ;
    sh:targetObjectsOf seam:mediaKind ;
    sh:class seam:MediaKind ;
    sh:message "seam:mediaKind takes a seam:MediaKind (seam:UIFragment or seam:Data)." .

#################################################################
# Operation implementation (ADR-0012)
#################################################################

seamsh:ImplementedByShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:implementedBy ;
    sh:class hydra:Operation ;
    sh:property [ sh:path seam:implementedBy ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An operation is seam:implementedBy at most one implementation, named by an IRI." ] ;
    sh:message "Only a hydra:Operation is seam:implementedBy an implementation." .

seamsh:ImplementationKindShape a sh:NodeShape ;
    sh:targetObjectsOf seam:implementedBy ;
    sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( comm:LLMCompletion comm:PythonHandler comm:HTTPEndpoint ) ;
        sh:message "An implementation has exactly one rdf:type, its kind: comm:LLMCompletion, comm:PythonHandler or comm:HTTPEndpoint." ] .

seamsh:PythonHandlerShape a sh:NodeShape ;
    sh:targetClass comm:PythonHandler ;
    sh:property [ sh:path comm:handler ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" ;
        sh:message "A comm:PythonHandler has exactly one comm:handler, a dotted path of Python identifiers inside the handlers package." ] .

# Separate shape so a model with no implementations at all is still checked: the
# operation is the target, and the query finds a remote invocation with none.
seamsh:RemoteImplementationShape a sh:NodeShape ;
    sh:targetObjectsOf seam:invokes ;
    sh:sparql [
        sh:message "An operation invoked across containers (its exposing container does not seam:executes the invoking process) declares a seam:implementedBy (ADR-0012)." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this WHERE {
                ?task seam:invokes $this ; seam:inModel ?model .
                ?process seam:detailedBy ?model .
                ?container seam:exposes $this .
                FILTER NOT EXISTS { ?container seam:executes ?process }
                FILTER NOT EXISTS { $this seam:implementedBy ?implementation }
            }""" ;
    ] .

#################################################################
# Operation errors and error boundaries (ADR-0013)
#################################################################

seamsh:ErrorStatusShape a sh:NodeShape ;
    sh:targetSubjectsOf comm:errorCode ;
    sh:class hydra:Status ;
    sh:property [ sh:path comm:errorCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^[A-Za-z][A-Za-z0-9._-]*$" ;
        sh:message "An error status has exactly one comm:errorCode: a string of letters, digits, '.', '_' or '-', starting with a letter." ] ;
    sh:property [ sh:path hydra:statusCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:minInclusive 400 ; sh:maxInclusive 599 ;
        sh:message "An error status has exactly one integer hydra:statusCode in 400..599." ] ;
    sh:property [ sh:path seam:returnsShape ; sh:minCount 1 ; sh:maxCount 1 ; sh:node seamsh:ProblemShapeShape ;
        sh:message "An error status seam:returnsShape exactly one error shape over problem+json (comm:title and an integer comm:status)." ] ;
    sh:property [ sh:path [ sh:inversePath hydra:possibleStatus ] ; sh:minCount 1 ; sh:class hydra:Operation ;
        sh:message "An error status is the hydra:possibleStatus of a hydra:Operation." ] ;
    sh:message "Only a hydra:Status carries a comm:errorCode." .

# Not targeted: applied through seamsh:ErrorStatusShape's sh:node to error shapes only.
seamsh:ProblemShapeShape a sh:NodeShape ;
    sh:property [ sh:path sh:property ;
        sh:qualifiedValueShape [
            sh:property [ sh:path sh:path ; sh:hasValue comm:status ] ;
            sh:property [ sh:path sh:datatype ; sh:hasValue xsd:integer ] ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An error shape declares the problem member comm:status with sh:datatype xsd:integer." ] ;
    sh:property [ sh:path sh:property ;
        sh:qualifiedValueShape [ sh:property [ sh:path sh:path ; sh:hasValue comm:title ] ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An error shape declares the problem member comm:title." ] .

seamsh:ErrorCodeUniqueShape a sh:NodeShape ;
    sh:targetSubjectsOf hydra:possibleStatus ;
    sh:sparql [
        sh:message "An operation's error statuses have distinct comm:errorCodes (ADR-0013)." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this hydra:possibleStatus ?a , ?b .
                ?a comm:errorCode ?value .
                ?b comm:errorCode ?value .
                FILTER (?a != ?b)
            }""" ;
    ] .

seamsh:CatchesShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:catches ;
    sh:class proc:ErrorBoundaryEvent ;
    sh:property [ sh:path seam:catches ; sh:maxCount 1 ; sh:class hydra:Status ;
        sh:message "An error boundary event seam:catches at most one hydra:Status." ] ;
    sh:property [ sh:path ( seam:catches comm:errorCode ) ; sh:minCount 1 ;
        sh:message "seam:catches points at an error status: a hydra:Status with a comm:errorCode." ] ;
    sh:message "Only a proc:ErrorBoundaryEvent seam:catches an error." .

seamsh:ErrorBoundaryEventShape a sh:NodeShape ;
    sh:targetClass proc:ErrorBoundaryEvent ;
    sh:property [ sh:path seam:catches ; sh:minCount 1 ;
        sh:message "A lifted error boundary event seam:catches the operation error it routes (ADR-0013)." ] .

#################################################################
# Deployment facts the generators read
#################################################################

seamsh:ArtifactShape a sh:NodeShape ;
    sh:targetObjectsOf deploy:artifact ;
    sh:property [ sh:path deploy:reference ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A deploy:artifact has exactly one string deploy:reference." ] ;
    sh:property [ sh:path deploy:version ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A deploy:artifact has at most one string deploy:version." ] ;
    sh:property [ sh:path deploy:build ; sh:maxCount 1 ;
        sh:message "A deploy:artifact has at most one deploy:build." ] .

seamsh:BuildShape a sh:NodeShape ;
    sh:targetObjectsOf deploy:build ;
    sh:property [ sh:path deploy:context ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A deploy:build has exactly one string deploy:context." ] ;
    sh:property [ sh:path deploy:dockerfile ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A deploy:build has at most one string deploy:dockerfile." ] .

# deploy:artifact, deploy:configuration and deploy:replicas have no rdfs:domain, since
# a container and an override both state them (ADR-0015); this shape is the domain.
seamsh:OverridableSubjectShape a sh:NodeShape ;
    sh:targetSubjectsOf deploy:artifact , deploy:configuration , deploy:replicas ;
    sh:or ( [ sh:class arch:Container ] [ sh:class deploy:Override ] ) ;
    sh:property [ sh:path deploy:artifact ; sh:maxCount 1 ;
        sh:message "A container or override has at most one deploy:artifact." ] ;
    sh:property [ sh:path deploy:replicas ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
        sh:message "deploy:replicas is at most one non-negative integer." ] ;
    sh:message "Only an arch:Container or a deploy:Override carries deploy:artifact, deploy:configuration or deploy:replicas." .

seamsh:PortShape a sh:NodeShape ;
    sh:targetObjectsOf deploy:port ;
    sh:property [ sh:path deploy:containerPort ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 65535 ;
        sh:message "A deploy:port has exactly one integer deploy:containerPort in 1..65535." ] ;
    sh:property [ sh:path deploy:publishedPort ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 65535 ;
        sh:message "deploy:publishedPort is at most one integer in 1..65535." ] .

seamsh:VolumeShape a sh:NodeShape ;
    sh:targetObjectsOf deploy:volume ;
    sh:property [ sh:path deploy:volumeName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A deploy:volume has exactly one string deploy:volumeName." ] ;
    sh:property [ sh:path deploy:mountPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^/" ;
        sh:message "A deploy:volume has exactly one absolute deploy:mountPath." ] .

seamsh:HealthcheckShape a sh:NodeShape ;
    sh:targetObjectsOf deploy:healthcheck ;
    sh:property [ sh:path deploy:probe ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A deploy:healthcheck has exactly one string deploy:probe." ] .

seamsh:BindingShape a sh:NodeShape ;
    sh:targetObjectsOf deploy:binding ;
    sh:property [ sh:path deploy:key ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A deploy:binding has exactly one deploy:key." ] ;
    sh:xone ( [ sh:path deploy:value ; sh:minCount 1 ]
              [ sh:path deploy:secretRef ; sh:minCount 1 ]
              [ sh:path deploy:secretFile ; sh:minCount 1 ]
              [ sh:path deploy:serviceOf ; sh:minCount 1 ] ) ;
    sh:property [ sh:path deploy:secretFile ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "deploy:secretFile is at most one string path." ] ;
    sh:property [ sh:path deploy:serviceOf ; sh:class arch:Container ;
        sh:message "deploy:serviceOf points at an arch:Container." ] ;
    sh:property [ sh:path deploy:connectsTo ; sh:maxCount 1 ; sh:class arch:Container ;
        sh:message "deploy:connectsTo points at one arch:Container (a store)." ] ;
    sh:message "A deploy:binding takes exactly one of deploy:value, deploy:secretRef, deploy:secretFile or deploy:serviceOf." .

seamsh:SecretNameShape a sh:NodeShape ;
    sh:targetSubjectsOf deploy:secretName ;
    sh:property [ sh:path deploy:secretRef ; sh:minCount 1 ;
        sh:message "deploy:secretName names the platform secret for a deploy:secretRef binding; a binding with a secretName must carry a secretRef." ] .

seamsh:ProxiesShape a sh:NodeShape ;
    sh:targetSubjectsOf deploy:proxies ;
    sh:class arch:Container ;
    sh:property [ sh:path deploy:proxies ; sh:maxCount 1 ; sh:class arch:Container ;
        sh:message "deploy:proxies points at one arch:Container." ] ;
    sh:message "Only an arch:Container deploy:proxies another." .

#################################################################
# Environments (ADR-0015)
#################################################################

# Each constraint below is a fault Container.for_environment raises ResolutionError
# for (principle 5).

seamsh:OverrideShape a sh:NodeShape ;
    sh:targetClass deploy:Override ;
    sh:targetObjectsOf deploy:override ;
    sh:class deploy:Override ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type deploy:environment deploy:artifact deploy:configuration deploy:replicas ) ;
    sh:property [ sh:path deploy:environment ; sh:minCount 1 ; sh:maxCount 1 ; sh:class arch:Environment ;
        sh:message "A deploy:Override names exactly one deploy:environment, an arch:Environment." ] ;
    sh:message "A deploy:Override is the object of deploy:override and carries only deploy:environment, deploy:artifact, deploy:configuration and deploy:replicas (ADR-0015)." .

seamsh:OverridePerEnvironmentShape a sh:NodeShape ;
    sh:targetSubjectsOf deploy:override ;
    sh:sparql [
        sh:message "A container has at most one deploy:override per deploy:environment (ADR-0015)." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this deploy:override ?a , ?b .
                ?a deploy:environment ?value .
                ?b deploy:environment ?value .
                FILTER (?a != ?b)
            }""" ;
    ] .

# The store is the same in every environment: an override binding keeps the
# deploy:connectsTo of the shared binding with its deploy:key, in both directions.
seamsh:OverrideStoreShape a sh:NodeShape ;
    sh:targetSubjectsOf deploy:override ;
    sh:sparql [
        sh:message "An override binding deploy:connectsTo the same store as the shared binding with its deploy:key; the store cannot change per environment (ADR-0015)." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this deploy:override/deploy:configuration/deploy:binding ?ob .
                ?ob deploy:key ?key .
                {
                    ?ob deploy:connectsTo ?value .
                    FILTER NOT EXISTS {
                        $this deploy:configuration/deploy:binding ?sb .
                        ?sb deploy:key ?key ; deploy:connectsTo ?value .
                    }
                } UNION {
                    $this deploy:configuration/deploy:binding ?sb .
                    ?sb deploy:key ?key ; deploy:connectsTo ?value .
                    FILTER NOT EXISTS { ?ob deploy:connectsTo ?value }
                }
            }""" ;
    ] .

#################################################################
# Storage (ADR-0011)
#################################################################

seamsh:StoredInShape a sh:NodeShape ;
    sh:targetSubjectsOf seam:storedIn ;
    sh:class sh:NodeShape ;
    sh:property [ sh:path seam:storedIn ; sh:maxCount 1 ; sh:class arch:Container ;
        sh:message "seam:storedIn points at one arch:Container (a store)." ] ;
    sh:message "Only a sh:NodeShape is seam:storedIn a store." .

seamsh:StoreShape a sh:NodeShape ;
    sh:targetObjectsOf seam:storedIn , deploy:connectsTo ;
    sh:property [ sh:path deploy:storeKind ; sh:minCount 1 ;
        sh:message "A store (the object of seam:storedIn or deploy:connectsTo) declares a deploy:storeKind." ] .

seamsh:StoreKindShape a sh:NodeShape ;
    sh:targetSubjectsOf deploy:storeKind ;
    sh:class arch:Container ;
    sh:property [ sh:path deploy:storeKind ; sh:maxCount 1 ;
        sh:in ( deploy:PostgreSQL deploy:SQLite ) ;
        sh:message "deploy:storeKind is at most one of deploy:PostgreSQL or deploy:SQLite." ] ;
    sh:message "Only an arch:Container carries a deploy:storeKind." .

#################################################################
# Scenarios and examples (ADR-0014)
#################################################################

# Each constraint below is a fault the tests generator would otherwise have to reject
# (principle 5): if a model's scenarios and examples pass these shapes, the generator
# can derive a test from every one of them.

seamsh:ScenarioShape a sh:NodeShape ;
    sh:targetClass verify:Scenario ;
    sh:targetSubjectsOf verify:process , verify:step , verify:expectState , verify:expectEndEvent ;
    sh:class verify:Scenario ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path verify:process ; sh:minCount 1 ; sh:maxCount 1 ; sh:class proc:Process ;
        sh:message "A scenario runs exactly one verify:process, a proc:Process." ] ;
    sh:property [ sh:path verify:actor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class odrl:Party ;
        sh:message "A scenario is started by exactly one verify:actor, an odrl:Party." ] ;
    sh:property [ sh:path verify:step ; sh:maxCount 1 ;
        sh:message "A scenario has at most one verify:step list." ] ;
    sh:property [ sh:path ( verify:step [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ; sh:node seamsh:StepShape ;
        sh:message "Each verify:step names one verify:task (a proc:UserTask) and one verify:actor (an odrl:Party)." ] ;
    sh:property [ sh:path verify:expectState ; sh:maxCount 1 ; sh:class state:State ;
        sh:message "A scenario expects at most one verify:expectState, a state:State." ] ;
    sh:property [ sh:path verify:expectEndEvent ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A scenario expects at most one verify:expectEndEvent, an IRI." ] ;
    sh:sparql [
        sh:message "A scenario states what it expects: a verify:expectState, a verify:expectEndEvent, or both." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this verify:expectState ?s }
                FILTER NOT EXISTS { $this verify:expectEndEvent ?e }
            }""" ;
    ] ;
    sh:sparql [
        sh:message "A scenario's process is started by a UI event: some ifml:Event seam:triggers it." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:process ?value .
                FILTER NOT EXISTS { ?event seam:triggers ?value }
            }""" ;
    ] ;
    sh:sparql [
        sh:message "verify:step is an RDF list (rdf:nil or a node with rdf:first)." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:step ?value .
                FILTER (?value != rdf:nil)
                FILTER NOT EXISTS { ?value rdf:first ?first }
            }""" ;
    ] ;
    sh:sparql [
        sh:message "A step's verify:task is in the same BPMN model (seam:inModel) as the scenario's process." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:process/seam:inModel ?model ;
                      verify:step/rdf:rest*/rdf:first/verify:task ?value .
                FILTER NOT EXISTS { ?value seam:inModel ?model }
            }""" ;
    ] ;
    sh:sparql [
        sh:message "verify:expectEndEvent is lifted into the scenario's process model (seam:inModel)." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:process/seam:inModel ?model ;
                      verify:expectEndEvent ?value .
                FILTER NOT EXISTS { ?value seam:inModel ?model }
            }""" ;
    ] ;
    sh:sparql [
        sh:message "verify:expectState is a state of a lifecycle some shape seam:lifecycle names, so the test knows whose state to read." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:expectState ?value .
                FILTER NOT EXISTS { ?machine state:hasState ?value . ?shape seam:lifecycle ?machine }
            }""" ;
    ] ;
    sh:message "Only a verify:Scenario carries verify:process, verify:step or an expected state or end event, and a scenario is an IRI (its local name names its generated test)." .

# Not targeted: applied to each member of a scenario's verify:step list.
seamsh:StepShape a sh:NodeShape ;
    sh:property [ sh:path verify:task ; sh:minCount 1 ; sh:maxCount 1 ; sh:class proc:UserTask ] ;
    sh:property [ sh:path verify:actor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class odrl:Party ] .

seamsh:GivenShape a sh:NodeShape ;
    sh:targetObjectsOf verify:given ;
    sh:property [ sh:path verify:field ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A verify:given value names exactly one verify:field, an IRI." ] ;
    sh:property [ sh:path verify:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ;
        sh:message "A verify:given value has exactly one verify:value, a literal." ] ;
    sh:sparql [
        sh:message "verify:field is the sh:path of a property of some shape in the model." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:field ?value .
                FILTER NOT EXISTS { ?shape sh:property ?property . ?property sh:path ?value }
            }""" ;
    ] .

seamsh:GivenUniqueShape a sh:NodeShape ;
    sh:targetSubjectsOf verify:given ;
    sh:sparql [
        sh:message "A scenario, step or decision example gives each verify:field at most once." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:given ?a , ?b .
                ?a verify:field ?value .
                ?b verify:field ?value .
                FILTER (?a != ?b)
            }""" ;
    ] .

seamsh:DecisionExampleShape a sh:NodeShape ;
    sh:targetClass verify:DecisionExample ;
    sh:targetSubjectsOf verify:decision , verify:expectOutput ;
    sh:class verify:DecisionExample ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path verify:decision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dec:Decision ;
        sh:message "A decision example evaluates exactly one verify:decision, a dec:Decision." ] ;
    sh:property [ sh:path verify:expectOutput ; sh:minCount 1 ; sh:node seamsh:ExpectOutputShape ;
        sh:message "A decision example expects at least one output: a dec:variable string and a literal verify:value." ] ;
    sh:sparql [
        sh:message "Each verify:given field of a decision example is the dec:fromPath of one of the decision's dec:input bindings." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:decision ?decision ;
                      verify:given/verify:field ?value .
                FILTER NOT EXISTS { ?decision dec:input/dec:fromPath ?value }
            }""" ;
    ] ;
    sh:sparql [
        sh:message "A decision example gives a value for every dec:input of its decision." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:decision ?decision .
                ?decision dec:input/dec:fromPath ?value .
                FILTER NOT EXISTS { $this verify:given/verify:field ?value }
            }""" ;
    ] ;
    sh:sparql [
        sh:message "Each expected output's dec:variable names one of the decision's dec:output bindings." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:decision ?decision ;
                      verify:expectOutput/dec:variable ?value .
                FILTER NOT EXISTS { ?decision dec:output/dec:variable ?value }
            }""" ;
    ] ;
    sh:message "Only a verify:DecisionExample carries verify:decision or verify:expectOutput, and a decision example is an IRI (its local name names its generated test)." .

# Not targeted: applied through seamsh:DecisionExampleShape to each expected output.
seamsh:ExpectOutputShape a sh:NodeShape ;
    sh:property [ sh:path dec:variable ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path verify:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] .

seamsh:ShapeExampleShape a sh:NodeShape ;
    sh:targetSubjectsOf verify:validExample , verify:invalidExample ;
    sh:class sh:NodeShape ;
    sh:property [ sh:path verify:validExample ; sh:nodeKind sh:IRI ;
        sh:message "A verify:validExample is an IRI: its local name names its generated test." ] ;
    sh:property [ sh:path verify:invalidExample ; sh:nodeKind sh:IRI ;
        sh:message "A verify:invalidExample is an IRI: its local name names its generated test." ] ;
    sh:sparql [
        sh:message "A node is not both a valid and an invalid example of the same shape." ;
        sh:prefixes <https://w3id.org/seams/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this verify:validExample ?value ;
                      verify:invalidExample ?value .
            }""" ;
    ] ;
    sh:message "Only a sh:NodeShape carries verify:validExample or verify:invalidExample." .
