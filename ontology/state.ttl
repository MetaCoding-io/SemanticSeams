@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix state: <https://w3id.org/seams/state#> .

#################################################################
# Statecharts (entity lifecycles) — SCXML-shaped, deliberately flat for v1
#################################################################

<https://w3id.org/seams/state> a owl:Ontology ;
    rdfs:label "Seams Statechart Vocabulary" ;
    rdfs:comment "Entity lifecycles as state machines. Hierarchical/parallel states deferred until a dogfood model needs them." .

state:StateMachine a rdfs:Class .

state:State a rdfs:Class .

state:Transition a rdfs:Class .

state:hasState a rdf:Property ;
    rdfs:domain state:StateMachine ; rdfs:range state:State .

state:initial a rdf:Property ;
    rdfs:domain state:StateMachine ; rdfs:range state:State .

state:final a rdf:Property ;
    rdfs:domain state:StateMachine ; rdfs:range state:State .

state:hasTransition a rdf:Property ;
    rdfs:domain state:StateMachine ; rdfs:range state:Transition .

state:from a rdf:Property ;
    rdfs:domain state:Transition ; rdfs:range state:State .

state:to a rdf:Property ;
    rdfs:domain state:Transition ; rdfs:range state:State .

state:trigger a rdf:Property ;
    rdfs:domain state:Transition ;
    rdfs:comment "Human-readable trigger label. Which process tasks may fire it lives on the seam (seam:fires)." .
