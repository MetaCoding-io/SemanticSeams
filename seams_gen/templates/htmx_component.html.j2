[#- The body of one component's {% block %} (D016), included by
    htmx_page.html.j2 inside the block and by htmx_fragment.html.j2 as a
    whole-component partial (GAP-19). Expects `c`, a Component. #]
[% if c.kind == "List" %]
  <nav id="[[ c.id ]]" aria-label="[[ c.label|e ]]">
    <ul>
      {% for [[ c.loop_var ]] in [[ c.collection ]] %}
      <li>
        <a href="#[[ c.link.flow.target ]]"
           hx-get="[[ c.link.get_path ]]"
           hx-trigger="[[ c.link.event_trigger ]]"
           hx-target="#[[ c.link.flow.target_id ]]"
           hx-swap="[[ c.link.flow.swap ]]"[[ "" if c.link.vals else ">" ]]
[% if c.link.vals %]
           hx-vals='{[% for k, v in c.link.vals %]"[[ k ]]": "{{ [[ v ]] }}"[[ "" if loop.last else ", " ]][% endfor %]}'>
[% endif %]
          {{ [[ c.loop_var ]].[[ c.display_field ]] }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </nav>
[% elif c.kind == "Details" %]
[% if c.guard_variable %]
[% if c.guard_states|length == 1 %]
  {% if [[ c.guard_variable ]] == "[[ c.guard_states[0] ]]" %}
[% else %]
  {% if [[ c.guard_variable ]] in ([% for s in c.guard_states %]"[[ s ]]"[[ "" if loop.last else ", " ]][% endfor %]) %}
[% endif %]
[% endif %]
  <section id="[[ c.id ]]" aria-label="[[ c.label|e ]]"[[ "" if c.parameters else ">" ]]
[% for p in c.parameters %]
           data-[[ p ]]="{{ [[ p ]] }}"[[ ">" if loop.last else "" ]]
[% endfor %]
    <ol id="[[ c.id ]]_items">
      {% for [[ c.loop_var ]] in [[ c.collection ]] %}
[% include "htmx_item.html.j2" %]
      {% endfor %}
    </ol>
[% if c.stream %]
    {# [[ c.stream.event_name ]] stream: [[ c.stream.publisher ]] seam:publishesTo [[ c.stream.curie ]] comm:Channel #}
    <div id="[[ c.stream.id ]]"
         hx-ext="sse"
         sse-connect="[[ c.stream.connect ]]"
         sse-swap="[[ c.stream.event_name ]]"
         hx-swap="beforeend">
    </div>
[% endif %]
  </section>
[% if c.guard_variable %]
  {% endif %}
[% endif %]
[% elif c.kind == "Form" %]
[% set s = c.submit %]
[% if s.triggers or s.event_policies %]
  {# [[ s.event ]][[ " seam:triggers " ~ s.triggers|join(", ") if s.triggers else "" ]][[ " ;" if s.triggers and s.event_policies else "" ]][[ " seam:governedBy " ~ s.event_policies|join(", ") if s.event_policies else "" ]] #}
[% endif %]
  {# [[ s.method_upper ]], [[ s.media_kind ]] response: [[ s.consumer ]] seam:consumes [[ s.operation ]] #}
  {# [[ s.event ]] seam:submitsTo [[ s.operation ]][[ " ; the route enforces seam:governedBy " ~ s.route_policies|join(", ") if s.route_policies else "" ]] #}
[% if s.mint %]
  {# {[[ s.mint|join("}, {") ]]} starts a new process instance: no component on the page binds it, so the browser fills it with a fresh random key on every submit #}
[% endif %]
  <form id="[[ c.id ]]" aria-label="[[ c.label|e ]]"
        hx-[[ s.method ]]="[[ s.path ]]"
[% if s.mint %]
        hx-on::config-request="[% for v in s.mint %]event.detail.path = event.detail.path.replace('{[[ v ]]}', Array.from(crypto.getRandomValues(new Uint8Array(8)), b => b.toString(16).padStart(2, '0')).join(''));[% endfor %]"
[% endif %]
        hx-target="#[[ s.flow.target_id ]]"
        hx-swap="[[ s.flow.swap ]]">
[% for i in c.inputs %]
    <label for="[[ i.id ]]">[[ i.name ]]</label>
    <[[ i.element ]] id="[[ i.id ]]"
[% for a in i.attributes %]
[[ " " * (i.element|length + 6) ]][[ a ]][[ ("></" ~ i.element ~ ">" if i.element == "textarea" else ">") if loop.last else "" ]]
[% endfor %]
[% endfor %]
[% if c.unbound %]
    {# [[ c.unbound|english_list ]] [[ "is" if c.unbound|length == 1 else "are" ]] set by the runtime, not entered: no parameter is ifml:boundTo [[ "it" if c.unbound|length == 1 else "them" ]] #}
[% endif %]
    <button type="submit">[[ s.label|e ]]</button>
  </form>
[% endif %]
