[#- The partial of an ifml:Form a proc:UserTask seam:completedOn (ADR-0009).
    The host's task inbox renders it once per open task with `task` bound to
    a Runtime.user_tasks row, so the correlation-key path variable and the
    element ids are filled from task.correlation_key. hx-target is the
    task's own <article>, since an inbox may hold several tasks; the swap is
    the event's ifml:NavigationFlow swap. Expects `page` and `t` (a TaskForm). -#]
{# Generated by the seams htmx generator from the [[ page.model_stem ]] model. Do not edit. #}
{# model-hash: [[ page.model_hash ]] #}
{# task form partial of ifml:Form [[ t.curie ]]: [[ t.task ]] seam:completedOn [[ t.curie ]] #}
{# Expects `task`, a Runtime.user_tasks row ([[ t.key ]] is task.correlation_key) #}
<article class="task" aria-label="[[ t.task_label|e ]]" data-task="[[ t.task ]]"
         data-[[ t.key ]]="{{ task.correlation_key }}">
  <h2>[[ t.task_label|e ]]</h2>
[% if t.entity_fields %]
  {% if task.entity %}
  <dl class="[[ t.entity_class ]]">
[% for fl in t.entity_fields %]
    <dt>[[ fl.name ]]</dt><dd class="[[ fl.name ]]">{{ task.entity.[[ fl.name ]] }}</dd>
[% endfor %]
  </dl>
  {% endif %}
[% endif %]
[% set s = t.submit %]
  {# [[ s.method_upper ]], [[ s.media_kind ]] response: [[ s.consumer ]] seam:consumes [[ s.operation ]] #}
  {# [[ s.event ]] seam:submitsTo [[ s.operation ]] ; the route enforces the seam:governedBy policies of [[ t.task ]] #}
  <form id="[[ t.id ]]_{{ task.correlation_key }}" aria-label="[[ t.label|e ]]"
        hx-[[ s.method ]]="[[ s.path ]]"
        hx-target="closest article"
        hx-swap="[[ s.flow.swap ]]">
[% for i in t.inputs %]
    <label for="[[ i.id ]]_{{ task.correlation_key }}">[[ i.name ]]</label>
[% if i.element == "select" %]
    <select id="[[ i.id ]]_{{ task.correlation_key }}"
[% for a in i.attributes %]
            [[ a ]][[ ">" if loop.last else "" ]]
[% endfor %]
[% for o in i.options %]
      <option value="[[ o|e ]]">[[ o|e ]]</option>
[% endfor %]
    </select>
[% else %]
    <[[ i.element ]] id="[[ i.id ]]_{{ task.correlation_key }}"
[% for a in i.attributes %]
[[ " " * (i.element|length + 6) ]][[ a ]][[ ("></" ~ i.element ~ ">" if i.element == "textarea" else ">") if loop.last else "" ]]
[% endfor %]
[% endif %]
[% endfor %]
[% if t.unbound %]
    {# [[ t.unbound|english_list ]] [[ "is" if t.unbound|length == 1 else "are" ]] set by the runtime, not entered: no parameter is ifml:boundTo [[ "it" if t.unbound|length == 1 else "them" ]] #}
[% endif %]
    <button type="submit">[[ s.label|e ]]</button>
  </form>
</article>
