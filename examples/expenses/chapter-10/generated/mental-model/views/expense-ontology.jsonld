      "urn:sempkm:vocab:rendererType": "table",
      "urn:sempkm:vocab:sparqlQuery": "SELECT ?s ?description ?amount ?date ?status ?id WHERE { ?s a <https://example.org/expenses/Expense> . OPTIONAL { ?s <https://example.org/expenses/description> ?description } OPTIONAL { ?s <https://example.org/expenses/amount> ?amount } OPTIONAL { ?s <https://example.org/expenses/date> ?date } OPTIONAL { ?s <https://example.org/expenses/status> ?status } OPTIONAL { ?s <https://example.org/expenses/id> ?id } }",
