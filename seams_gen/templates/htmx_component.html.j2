[#- The body of one component's {% block %} (D016), included by
    htmx_page.html.j2 inside the block and by htmx_fragment.html.j2 as a
    whole-component partial (GAP-19). Expects `c`, a Component. #]
[% if c.is_list %]
  <nav id="[[ c.id ]]" aria-label="[[ c.label|e ]]">
    <ul>
      {% for [[ c.loop_var ]] in [[ c.collection ]] %}
      <li>
        <a href="#[[ c.link.flow.target ]]"
           hx-get="[[ c.link.get_path ]]"
           hx-trigger="[[ c.link.event_trigger ]]"
           hx-target="#[[ c.link.flow.target_id ]]"
           hx-swap="[[ c.link.flow.swap ]]"[[ c.link.close ]]
[% if c.link.vals %]
           hx-vals='{[% for v in c.link.val_items %]"[[ v.name ]]": "{{ [[ v.expr ]] }}"[[ v.after ]][% endfor %]}'>
[% endif %]
          {{ [[ c.loop_var ]].[[ c.display_field ]] }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </nav>
[% elif c.is_details %]
[% if c.guard_variable %]
[% if c.single_guard_state %]
  {% if [[ c.guard_variable ]] == [[ c.guard_states_text ]] %}
[% else %]
  {% if [[ c.guard_variable ]] in ([[ c.guard_states_text ]]) %}
[% endif %]
[% endif %]
  <section id="[[ c.id ]]" aria-label="[[ c.label|e ]]"[[ c.section_close ]]
[% for p in c.parameter_items %]
           data-[[ p.value ]]="{{ [[ p.value ]] }}"[[ p.after ]]
[% endfor %]
    <ol id="[[ c.id ]]_items">
      {% for [[ c.loop_var ]] in [[ c.collection ]] %}
[% include "htmx_item.html.j2" %]
      {% endfor %}
    </ol>
[% if c.stream %]
    {# [[ c.stream.event_name ]] stream: [[ c.stream.publisher ]] seam:publishesTo [[ c.stream.curie ]] comm:Channel #}
    <div id="[[ c.stream.id ]]"
         hx-ext="sse"
         sse-connect="[[ c.stream.connect ]]"
         sse-swap="[[ c.stream.event_name ]]"
         hx-swap="beforeend">
    </div>
[% endif %]
  </section>
[% if c.guard_variable %]
  {% endif %}
[% endif %]
[% elif c.is_form %]
[% set s = c.submit %]
[% if s.event_note %]
  {# [[ s.event ]][[ s.event_note ]] #}
[% endif %]
  {# [[ s.method_upper ]], [[ s.media_kind ]] response: [[ s.consumer ]] seam:consumes [[ s.operation ]] #}
  {# [[ s.event ]] seam:submitsTo [[ s.operation ]][[ s.route_note ]] #}
[% if s.mint %]
  {# {[[ s.mint_text ]]} starts a new process instance: no component on the page binds it, so the browser fills it with a fresh random key on every submit #}
[% endif %]
  <form id="[[ c.id ]]" aria-label="[[ c.label|e ]]"
        hx-[[ s.method ]]="[[ s.path ]]"
[% if s.mint %]
        hx-on::config-request="[% for v in s.mint %]event.detail.path = event.detail.path.replace('{[[ v ]]}', Array.from(crypto.getRandomValues(new Uint8Array(8)), b => b.toString(16).padStart(2, '0')).join(''));[% endfor %]"
[% endif %]
        hx-target="#[[ s.flow.target_id ]]"
        hx-swap="[[ s.flow.swap ]]">
[% for i in c.inputs %]
    <label for="[[ i.id ]]">[[ i.name ]]</label>
    <[[ i.element ]] id="[[ i.id ]]"
[% for a in i.attribute_items %]
[[ i.indent ]][[ a.value ]][[ a.after ]]
[% endfor %]
[% endfor %]
[% if c.unbound %]
    {# [[ c.unbound_text ]] [[ c.unbound_verb ]] set by the runtime, not entered: no parameter is ifml:boundTo [[ c.unbound_pronoun ]] #}
[% endif %]
    <button type="submit">[[ s.label|e ]]</button>
  </form>
[% endif %]
