[#- The seams htmx page template (D016). Rendered with square-bracket
    delimiters, so the Jinja2 {{ }} / {% %} / {# #} it emits are plain text.
    Fixed text lives here; every model-specific value comes from the PageModel
    built by seams_gen/htmx.py, and this file holds no graph queries. Each
    block body is htmx_component.html.j2, shared with the fragment partials
    (htmx_fragment.html.j2). -#]
{# Generated by the seams htmx generator from the [[ page.model_stem ]] model. Do not edit. #}
{# model-hash: [[ page.model_hash ]] #}
{# page [[ page.curie ]], from [[ page.interaction_model ]] ifml:contains [[ page.curie ]] ; ifml:isLandmark true #}
{# route: GET [[ page.path ]] (the landmark page is the app entry point) #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>[[ page.title|e ]]</title>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
[% if page.uses_sse %]
  <script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
[% endif %]
</head>
<body>
<main id="[[ page.id ]]" data-seam="[[ page.curie ]]">
[% for c in page.components %]
[% if not loop.first %]

[% endif %]
  {# [[ c.type_curie ]] [[ c.curie ]][[ ", seam:reads " ~ c.reads if c.reads else "" ]][[ ", seam:writes " ~ c.writes if c.writes else "" ]][[ ", seam:visibleWhen " ~ c.guard_state_curie if c.guard_state_curie else "" ]] #}
  {% block [[ c.id ]] %}
[% include "htmx_component.html.j2" %]
  {% endblock %}
[% endfor %]
</main>
</body>
</html>
