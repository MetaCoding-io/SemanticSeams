# What breaks if ?node goes away?
#
# Returns everything that transitively depends on a container deployed to the
# node — including the deployed containers themselves (path length 0), the
# processes they execute and the data stored on it. Dependency edges walked:
#   - arch:dependsOn               : design-time dependency
#   - seam:consumes/^seam:exposes  : contract-level dependency via an operation/channel
#   - ^seam:executes               : a process depends on the container that runs it
#   - seam:storedIn                : a data shape depends on the store holding its rows
#
# Bind ?node to an arch:DeploymentNode.

PREFIX seam: <https://w3id.org/seams/seam#>
PREFIX arch: <https://w3id.org/seams/arch#>

SELECT DISTINCT ?impacted WHERE {
  ?container seam:deployedTo ?node .
  ?impacted ( arch:dependsOn
            | (seam:consumes/^seam:exposes)
            | ^seam:executes
            | seam:storedIn
            )* ?container .
}
