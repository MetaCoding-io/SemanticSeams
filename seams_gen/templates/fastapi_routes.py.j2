[#- A thin FastAPI route module (M004/S05, ADR-0007 rule 1, D017).
    Expects `r` (a RoutesModel) and `m` (one of its RouteModules). Every
    model-specific string comes from them; the branches below choose a layout
    from graph facts and never reach the generated code. -#]
# Generated by the seams FastAPI generator from the [[ r.model_stem ]] model. Do not edit.
# model-hash: [[ r.model_hash ]]
# Route module for [[ m.curie ]], from [[ m.system ]] arch:contains [[ m.curie ]]
# [[ m.curie ]] seam:exposes [[ m.exposes|join(" , ") ]]
[% for n in m.not_routed %]
# [[ n.operation ]] is not routed here: [[ n.container ]] seam:exposes [[ n.operation ]]
[% endfor %]
[% for o in m.invoked_only %]
# [[ o ]] is not routed: a task seam:invokes it and no ifml:Event seam:submitsTo it, so the runtime calls it in-process
[% endfor %]
# ADR-0007 rule 1: handlers hold no domain logic; the runtime interprets BPMN/DMN/SHACL
# Handler names: the operation or channel IRI local name minus a trailing _op (gaps.md GAP-21)

from fastapi import APIRouter, Depends, Request
from fastapi.responses import HTMLResponse, StreamingResponse
[% if m.needs_identity %]
from seams_runtime import Identity, Runtime
[% else %]
from seams_runtime import Runtime
[% endif %]

MODEL_HASH = "[[ r.model_hash ]]"

# ADR-0007 rule 2: the runtime loads the mounted model and refuses a different hash
runtime = Runtime.load("/model/[[ r.model_file ]]", model_hash=MODEL_HASH)
router = APIRouter()
[% for e in m.endpoints %]


[% if e.channel %]
# [[ e.curie ]] a comm:Channel ; comm:transport comm:SSE[[ " ; seam:acceptsShape " ~ e.accepts if e.accepts else "" ]]
@router.get("[[ e.path ]]")
async def [[ e.name ]]([[ e.arguments|join(", ") ]]) -> StreamingResponse:
    events = runtime.subscribe("[[ e.curie ]]", scope=[[ e.scope ]])
    return StreamingResponse(events, media_type="text/event-stream")
[% else %]
# [[ e.curie ]] a hydra:Operation ; hydra:method "[[ e.method ]]"
[% if e.complete %]
# [[ e.complete.task ]] seam:completedOn the form that submits here (ADR-0009); its policies authorize the identity
[% endif %]
[% if e.policies %]
@router.[[ e.method|lower ]](
    "[[ e.path ]]",
    response_class=HTMLResponse,
    dependencies=[[ "[" ]][% for p in e.policies %]Depends(runtime.policy("[[ p ]]"))[[ "" if loop.last else ", " ]][% endfor %]],
)
[% else %]
@router.[[ e.method|lower ]]("[[ e.path ]]", response_class=HTMLResponse)
[% endif %]
async def [[ e.name ]]([[ e.arguments|join(", ") ]]) -> HTMLResponse:
[% if e.body %]
    [[ e.body.var ]] = await request.[[ e.body.call ]]()
[% endif %]
[% if e.validate and not e.write and not e.complete %]
    [[ e.validate.var ]] = runtime.validate("[[ e.validate.shape ]]", [[ e.validate.source ]])
[% endif %]
[% if e.start %]
    await runtime.start_process(
        "[[ e.start.process ]]",
        [[ e.start.payload ]],
        correlation_key=[[ e.start.key ]],
    )
[% endif %]
[% if e.complete %]
    await runtime.complete_task(
        "[[ e.complete.task ]]",
        [[ e.complete.payload ]],
        correlation_key=[[ e.complete.key ]],
        identity=identity,
    )
[% endif %]
[% if e.write %]
    [[ e.write.var ]] = runtime.write("[[ e.write.shape ]]", [[ e.write.source ]])
[% endif %]
[% if e.query %]
    [[ e.query.var ]] = runtime.query("[[ e.query.shape ]]"[% for v in e.query.filters %], [[ v ]]=[[ v ]][% endfor %])
[% endif %]
[% if e.render.multiline %]
    return runtime.render_fragment(
        "[[ e.render.name ]]",
        [[ e.render.data ]],
[% for p in e.render.params %]
        [[ p ]]=[[ p ]],
[% endfor %]
    )
[% else %]
    return runtime.render_fragment("[[ e.render.name ]]", [[ e.render.data ]][% for p in e.render.params %], [[ p ]]=[[ p ]][% endfor %])
[% endif %]
[% endif %]
[% endfor %]
