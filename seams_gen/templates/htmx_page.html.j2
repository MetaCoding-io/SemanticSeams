[#- The seams htmx page template (D016). Rendered with square-bracket
    delimiters, so the Jinja2 {{ }} / {% %} / {# #} it emits are plain text.
    Fixed text lives here; every model-specific value comes from the PageModel
    built by seams_gen/htmx.py, and this file holds no graph queries. -#]
{# Generated by the seams htmx generator from the [[ page.model_stem ]] model. Do not edit. #}
{# model-hash: [[ page.model_hash ]] #}
{# page [[ page.curie ]], from [[ page.interaction_model ]] ifml:contains [[ page.curie ]] ; ifml:isLandmark true #}
{# route: GET [[ page.path ]] (the landmark page is the app entry point) #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>[[ page.title|e ]]</title>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
[% if page.uses_sse %]
  <script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
[% endif %]
</head>
<body>
<main id="[[ page.id ]]" data-seam="[[ page.curie ]]">
[% for c in page.components %]
[% if not loop.first %]

[% endif %]
  {# [[ c.type_curie ]] [[ c.curie ]][[ ", seam:reads " ~ c.reads if c.reads else "" ]][[ ", seam:writes " ~ c.writes if c.writes else "" ]][[ ", seam:visibleWhen " ~ c.guard_state_curie if c.guard_state_curie else "" ]] #}
  {% block [[ c.id ]] %}
[% if c.kind == "List" %]
  <nav id="[[ c.id ]]" aria-label="[[ c.label|e ]]">
    <ul>
      {% for [[ c.loop_var ]] in [[ c.collection ]] %}
      <li>
        <a href="#[[ c.link.flow.target ]]"
           hx-get="[[ c.link.get_path ]]"
           hx-trigger="[[ c.link.event_trigger ]]"
           hx-target="#[[ c.link.flow.target_id ]]"
           hx-swap="[[ c.link.flow.swap ]]"[[ "" if c.link.vals else ">" ]]
[% if c.link.vals %]
           hx-vals='{[% for k, v in c.link.vals %]"[[ k ]]": "{{ [[ v ]] }}"[[ "" if loop.last else ", " ]][% endfor %]}'>
[% endif %]
          {{ [[ c.loop_var ]].[[ c.display_field ]] }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </nav>
[% elif c.kind == "Details" %]
[% if c.guard_variable %]
  {% if [[ c.guard_variable ]] == "[[ c.guard_state ]]" %}
[% endif %]
  <section id="[[ c.id ]]" aria-label="[[ c.label|e ]]"[[ "" if c.parameters else ">" ]]
[% for p in c.parameters %]
           data-[[ p ]]="{{ [[ p ]] }}"[[ ">" if loop.last else "" ]]
[% endfor %]
    <ol id="[[ c.id ]]_items">
      {% for [[ c.loop_var ]] in [[ c.collection ]] %}
      <li class="[[ c.item_class ]]">
[% for fl in c.fields %]
[% set value = "{{ " ~ c.loop_var ~ "." ~ fl.name ~ " }}" %]
[% if fl.kind == "textarea" %]
        <p>[[ value ]]</p>
[% elif fl.kind == "datetime" %]
        <time datetime="[[ value ]]">[[ value ]]</time>
[% else %]
        <span class="[[ fl.name ]]">[[ value ]]</span>
[% endif %]
[% endfor %]
      </li>
      {% endfor %}
    </ol>
[% if c.stream %]
    {# [[ c.stream.event_name ]] stream: [[ c.stream.publisher ]] seam:publishesTo [[ c.stream.curie ]] comm:Channel #}
    <div id="[[ c.stream.id ]]"
         hx-ext="sse"
         sse-connect="[[ c.stream.connect ]]"
         sse-swap="[[ c.stream.event_name ]]"
         hx-swap="beforeend">
    </div>
[% endif %]
  </section>
[% if c.guard_variable %]
  {% endif %}
[% endif %]
[% elif c.kind == "Form" %]
[% set s = c.submit %]
[% if s.triggers or s.event_policies %]
  {# [[ s.event ]][[ " seam:triggers " ~ s.triggers|join(", ") if s.triggers else "" ]][[ " ;" if s.triggers and s.event_policies else "" ]][[ " seam:governedBy " ~ s.event_policies|join(", ") if s.event_policies else "" ]] #}
[% endif %]
  {# [[ s.method_upper ]], [[ s.media_kind ]] response: [[ s.consumer ]] seam:consumes [[ s.operation ]] #}
  {# [[ s.event ]] seam:submitsTo [[ s.operation ]][[ " ; the route enforces seam:governedBy " ~ s.route_policies|join(", ") if s.route_policies else "" ]] #}
  <form id="[[ c.id ]]" aria-label="[[ c.label|e ]]"
        hx-[[ s.method ]]="[[ s.path ]]"
        hx-target="#[[ s.flow.target_id ]]"
        hx-swap="[[ s.flow.swap ]]">
[% for i in c.inputs %]
    <label for="[[ i.id ]]">[[ i.name ]]</label>
    <[[ i.element ]] id="[[ i.id ]]"
[% for a in i.attributes %]
[[ " " * (i.element|length + 6) ]][[ a ]][[ ("></" ~ i.element ~ ">" if i.element == "textarea" else ">") if loop.last else "" ]]
[% endfor %]
[% endfor %]
[% if c.unbound %]
    {# [[ c.unbound|english_list ]] [[ "is" if c.unbound|length == 1 else "are" ]] set by the runtime, not entered: no parameter is ifml:boundTo [[ "it" if c.unbound|length == 1 else "them" ]] #}
[% endif %]
    <button type="submit">[[ s.label|e ]]</button>
  </form>
[% endif %]
  {% endblock %}
[% endfor %]
</main>
</body>
</html>
