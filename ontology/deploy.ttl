@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix arch:   <https://w3id.org/seams/arch#> .
@prefix deploy: <https://w3id.org/seams/deploy#> .

<https://w3id.org/seams/deploy> a owl:Ontology ;
    rdfs:label "SemanticSeams Deployment Vocabulary (stub)" ;
    rdfs:comment """The VERB side of infrastructure. arch: describes what runs where
(nouns); deploy: describes how a container comes into existence: artifact, config,
resources, ordering, and placement policy. This graph does not launch anything —
deployment artifacts (docker-compose, Ansible inventory/plays, k8s manifests) are
GENERATED projections of it, exactly as a Gantt chart is a projection of plan:.

Prior art: TOSCA (heavyweight standard for topology + orchestration templates,
read but not adopted); BESSER's deployment modeling extension (same gap, same fix).

GitOps loop: the as-designed named graph is desired state; a generator/reconciler
emits and applies artifacts; an observer writes actual state into an as-deployed
named graph (Zabbix/monitoring as data source). Drift detection = SPARQL diff
between the two graphs — with semantics ('order_api violates its placement
policy'), not textual YAML diffs.

Design rule inherited from seam.ttl: few and generic. Values that are secrets are
referenced by IRI (e.g. into a secret manager), never inlined as literals.""" .

#################################################################
# Artifact and configuration
#################################################################

deploy:Artifact a rdfs:Class ;
    rdfs:comment "A launchable unit: OCI image, package, VM template. Identified by reference + version." .

deploy:artifact a rdf:Property ;
    rdfs:range deploy:Artifact ;
    rdfs:comment "On an arch:Container (shared) or a deploy:Override (one environment). No rdfs:domain: two would mean both, so shapes/seam-shapes.ttl states the allowed subjects (ADR-0015)." .

deploy:reference a rdf:Property ;
    rdfs:domain deploy:Artifact ;
    rdfs:comment "Image/package reference, e.g. 'ghcr.io/org/order-api'." .

deploy:version a rdf:Property ;
    rdfs:domain deploy:Artifact .

deploy:Build a rdfs:Class ;
    rdfs:label "Build" ;
    rdfs:comment "How to build an artifact from source instead of pulling it: a deploy:context and a deploy:dockerfile (ADR-0015)." .

deploy:build a rdf:Property ;
    rdfs:label "build" ;
    rdfs:domain deploy:Artifact ; rdfs:range deploy:Build ;
    rdfs:comment "Build the artifact from source. Generator rule: an artifact with a build renders as compose 'build' with 'pull_policy: build', one without as a pulled 'image'." .

deploy:context a rdf:Property ;
    rdfs:label "context" ;
    rdfs:domain deploy:Build ; rdfs:range xsd:string ;
    rdfs:comment "The build context directory, relative to the model file's directory (like seam:renderPayload paths)." .

deploy:dockerfile a rdf:Property ;
    rdfs:label "dockerfile" ;
    rdfs:domain deploy:Build ; rdfs:range xsd:string ;
    rdfs:comment "The Dockerfile, relative to the build deploy:context, as in Docker." .

deploy:Configuration a rdfs:Class ;
    rdfs:comment "A set of environment bindings for a container in an environment." .

deploy:configuration a rdf:Property ;
    rdfs:range deploy:Configuration ;
    rdfs:comment "On an arch:Container (shared) or a deploy:Override (one environment, merged with the shared bindings by deploy:key). No rdfs:domain, as for deploy:artifact (ADR-0015)." .

deploy:binding a rdf:Property ;
    rdfs:domain deploy:Configuration ;
    rdfs:comment "A key/value pair (blank node with deploy:key and one of deploy:value, deploy:secretRef, deploy:secretFile or deploy:serviceOf)." .

deploy:key a rdf:Property .
deploy:value a rdf:Property .
deploy:secretRef a rdf:Property ;
    rdfs:comment "IRI into a secret manager (e.g. an Infisical path). NEVER inline secret literals." .

deploy:secretName a rdf:Property ;
    rdfs:label "secret name" ;
    rdfs:comment "Name of the secret in the target platform's secret store (e.g. a compose/swarm external secret), on a binding that carries a deploy:secretRef. The secret value never enters the graph; generators render the name as an external secret source." .

deploy:secretFile a rdf:Property ;
    rdfs:label "secret file" ;
    rdfs:range xsd:string ;
    rdfs:comment "On a binding, instead of deploy:secretRef: the secret is read from this file, not from a platform secret store. The path is relative to the model file's directory; the file's contents never enter the graph. Generators render it as a file secret the host can repoint with <KEY>_FILE (ADR-0015)." .

deploy:serviceOf a rdf:Property ;
    rdfs:label "service of" ;
    rdfs:range arch:Container ;
    rdfs:comment "Derived binding: the binding's value is the in-network URL of the referenced container, rendered as http://<service name>:<deploy:containerPort>. Use instead of a literal deploy:value so the URL follows the target's name and port." .

#################################################################
# Environments (ADR-0015)
#################################################################

deploy:Override a rdfs:Class ;
    rdfs:label "Override" ;
    rdfs:comment "An environment-scoped set of facts about one container: a qualified relation naming its deploy:environment and carrying replacement deploy:artifact, deploy:configuration or deploy:replicas facts. An override's artifact and replicas replace the shared ones whole; its bindings replace the shared binding with the same deploy:key or add one. Absent means shared, never unset (ADR-0015)." .

deploy:override a rdf:Property ;
    rdfs:label "override" ;
    rdfs:domain arch:Container ; rdfs:range deploy:Override ;
    rdfs:comment "A container's environment-scoped facts. At most one per environment (constraint in shapes/seam-shapes.ttl)." .

deploy:environment a rdf:Property ;
    rdfs:label "environment" ;
    rdfs:domain deploy:Override ; rdfs:range arch:Environment ;
    rdfs:comment "The arch:Environment an override's facts hold in." .

deploy:proxies a rdf:Property ;
    rdfs:label "proxies" ;
    rdfs:domain arch:Container ; rdfs:range arch:Container ;
    rdfs:comment "A code-free reverse proxy and its target: the container forwards every request to the referenced container's single deploy:port (ADR-0015)." .

#################################################################
# Network, storage, readiness
#################################################################

deploy:Port a rdfs:Class ;
    rdfs:label "Port" ;
    rdfs:comment "A port a container listens on. Without deploy:publishedPort it is internal to the deployment network (compose 'expose'); with one it is published to the host (compose 'ports')." .

deploy:port a rdf:Property ;
    rdfs:label "port" ;
    rdfs:domain arch:Container ; rdfs:range deploy:Port .

deploy:containerPort a rdf:Property ;
    rdfs:label "container port" ;
    rdfs:domain deploy:Port ; rdfs:range xsd:integer ;
    rdfs:comment "Port number the container listens on." .

deploy:publishedPort a rdf:Property ;
    rdfs:label "published port" ;
    rdfs:domain deploy:Port ; rdfs:range xsd:integer ;
    rdfs:comment "Host port the container port is published on. Absent means internal only." .

deploy:Volume a rdfs:Class ;
    rdfs:label "Volume" ;
    rdfs:comment "Named persistent storage that outlives a container, mounted into it at deploy:mountPath." .

deploy:volume a rdf:Property ;
    rdfs:label "volume" ;
    rdfs:domain arch:Container ; rdfs:range deploy:Volume .

deploy:volumeName a rdf:Property ;
    rdfs:label "volume name" ;
    rdfs:domain deploy:Volume ;
    rdfs:comment "Name of the volume resource (compose top-level 'volumes' key)." .

deploy:mountPath a rdf:Property ;
    rdfs:label "mount path" ;
    rdfs:domain deploy:Volume ;
    rdfs:comment "Absolute path inside the container where the volume is mounted." .

deploy:Healthcheck a rdfs:Class ;
    rdfs:label "Healthcheck" ;
    rdfs:comment "How the platform decides a container is ready: a probe command run on an interval." .

deploy:healthcheck a rdf:Property ;
    rdfs:label "healthcheck" ;
    rdfs:domain arch:Container ; rdfs:range deploy:Healthcheck .

deploy:probe a rdf:Property ;
    rdfs:label "probe" ;
    rdfs:domain deploy:Healthcheck ;
    rdfs:comment "Shell command whose exit status 0 means ready (compose renders it as CMD-SHELL)." .

deploy:interval a rdf:Property ;
    rdfs:label "interval" ;
    rdfs:domain deploy:Healthcheck ;
    rdfs:comment "Time between probes, as a duration string (e.g. '5s')." .

deploy:StoreKind a rdfs:Class ;
    rdfs:label "Store kind" ;
    rdfs:comment "Controlled vocabulary of the stores the runtime can use (ADR-0011). The runtime checks a store's deploy:storeKind against it; arch:technology stays free text for people and is never read." .

deploy:PostgreSQL a deploy:StoreKind ;
    rdfs:label "PostgreSQL" ;
    rdfs:comment "A PostgreSQL server, reached through a deploy:connectsTo binding on the executing container." .

deploy:SQLite a deploy:StoreKind ;
    rdfs:label "SQLite" ;
    rdfs:comment "An embedded SQLite file. No connection is needed; the path comes from the SEAMS_DB environment variable." .

deploy:storeKind a rdf:Property ;
    rdfs:label "store kind" ;
    rdfs:domain arch:Container ; rdfs:range deploy:StoreKind ;
    rdfs:comment "Store arch:Container -> the deploy:StoreKind it is. Exactly one per store (constraint in shapes/seam-shapes.ttl)." .

deploy:connectsTo a rdf:Property ;
    rdfs:label "connects to" ;
    rdfs:range arch:Container ;
    rdfs:comment "On a deploy:binding blank node: the store arch:Container whose connection string the binding carries. It sits beside deploy:serviceOf; the value still comes from deploy:secretRef / deploy:secretName (or deploy:value for a non-secret dev URL), and the runtime reads the environment variable named by the binding's deploy:key, never a fixed key name (ADR-0011)." .

#################################################################
# Resources, replication, ordering
#################################################################

deploy:cpu a rdf:Property ;
    rdfs:domain arch:Container ; rdfs:comment "Requested CPU (free-form for v1, e.g. '2')." .

deploy:memory a rdf:Property ;
    rdfs:domain arch:Container ; rdfs:comment "Requested memory (e.g. '4Gi')." .

deploy:replicas a rdf:Property ;
    rdfs:range xsd:integer ;
    rdfs:comment "Requested number of running INSTANCES of the container, not a node count. On an arch:Container (shared) or a deploy:Override (one environment); no rdfs:domain, as for deploy:artifact. Until backlog A10 the generator runs the serving container with one replica whatever this says (ADR-0015)." .

deploy:dependsOn a rdf:Property ;
    rdfs:domain arch:Container ; rdfs:range arch:Container ;
    rdfs:comment "Startup ordering, distinct from arch:dependsOn (design-time dependency)." .

#################################################################
# Placement: policy in, resolved fact out
#################################################################

deploy:PlacementPolicy a rdfs:Class ;
    rdfs:comment "WHY a container lands where it does: affinity to an Environment or node class, hardware requirements, anti-affinity. seam:deployedTo becomes the RESOLVED OUTPUT of applying this policy, not a hand-asserted fact." .

deploy:placement a rdf:Property ;
    rdfs:domain arch:Container ; rdfs:range deploy:PlacementPolicy ;
    rdfs:comment "Placement policy of the container. Generator rule: the RESOLVED placement, the container's seam:deployedTo node, renders as the swarm constraint 'node.labels.seams.node == <node rdfs:label>' whether or not a policy is asserted; the policy explains the choice, the deployedTo fact drives the output." .

deploy:targetEnvironment a rdf:Property ;
    rdfs:domain deploy:PlacementPolicy ; rdfs:range arch:Environment .

deploy:requires a rdf:Property ;
    rdfs:domain deploy:PlacementPolicy ;
    rdfs:comment "Free-form capability requirement for v1 (e.g. 'fast-disks', 'gpu'). Matched against deploy:capability advertised by nodes." .

deploy:capability a rdf:Property ;
    rdfs:domain arch:DeploymentNode ;
    rdfs:comment "Free-form capability a deployment node advertises (e.g. 'fast-disks', 'gpu'); matched by deploy:requires. Split from deploy:requires so neither property violates its own domain." .

deploy:antiAffinity a rdf:Property ;
    rdfs:domain deploy:PlacementPolicy ; rdfs:range arch:Container ;
    rdfs:comment "Must not co-locate with the referenced container." .
