[# The docker compose file of the arch:System's containers (seams_gen.compose, D018).
   Every value is pre-rendered as a YAML scalar by the extractor. #]
# Generated by the seams compose generator from the [[ c.model_stem ]] model. Do not edit.
# model-hash: [[ c.model_hash ]]
services:
[% for s in c.services %]
  [[ s.name ]]:
    image: [[ s.image ]]
[% if s.ports %]
    ports:
[% for p in s.ports %]
      - "[[ p ]]"
[% endfor %]
[% endif %]
[% if s.expose %]
    expose:
[% for p in s.expose %]
      - "[[ p ]]"
[% endfor %]
[% endif %]
[% if s.depends_on %]
    depends_on:
[% for d in s.depends_on %]
      - [[ d ]]
[% endfor %]
[% endif %]
[% if s.environment %]
    environment:
[% for key, value in s.environment %]
      [[ key ]]: [[ value ]]
[% endfor %]
[% endif %]
[% if s.secrets %]
    secrets:
[% for k in s.secrets %]
      - [[ k ]]
[% endfor %]
[% endif %]
[% if s.volumes %]
    volumes:
[% for v in s.volumes %]
      - [[ v ]]
[% endfor %]
[% endif %]
[% if s.healthcheck %]
    healthcheck:
      test: ["CMD-SHELL", [[ s.healthcheck.test ]]]
      interval: [[ s.healthcheck.interval ]]
[% endif %]
[% if s.replicas is not none or s.placement %]
    deploy:
[% if s.replicas is not none %]
      replicas: [[ s.replicas ]]
[% endif %]
[% if s.placement %]
      placement:
        constraints:
          - [[ s.placement ]]
[% endif %]
[% endif %]
[% endfor %]
[% if c.secrets %]
secrets:
[% for s in c.secrets %]
  [[ s.key ]]:
    name: [[ s.name ]]
    external: true
[% endfor %]
[% endif %]
[% if c.volumes %]
volumes:
[% for v in c.volumes %]
  [[ v ]]: {}
[% endfor %]
[% endif %]
